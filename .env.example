NODE_ENV=production
PORT=4000

# Express trust-proxy setting. Behind the Cloudflare tunnel the client IP comes
# via X-Forwarded-For; this declares how many/which proxies to trust so rate
# limiting works (default 'loopback'). Use 'true', 'false', a hop count, or a
# named value. Set to a number (e.g. 2) if you add Traefik/another proxy hop.
TRUST_PROXY=loopback

# MySQL (matches docker-compose service name — do NOT change to localhost)
DATABASE_URL=mysql://root:CHANGE_ME@mysql:3306/pokyh
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Discrete DB connection fields. If DATABASE_URL is left blank it is built from
# these (user/password URL-encoded automatically). DATABASE_URL wins when set.
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=pokyh
DB_CONNECTION_LIMIT=20
DB_AUTO_PUSH=true
DB_PUSH_TIMEOUT_MS=120000
DB_CONNECT_BASE_DELAY_MS=2000
DB_CONNECT_MAX_DELAY_MS=30000

# JWT / API secrets — generate each with: openssl rand -hex 32
JWT_SECRET=
REFRESH_TOKEN_SECRET=
API_KEY=
SERVER_KEY=

# CORS — comma-separated browser origins, no trailing slash. The API accepts
# the corresponding www/apex alias too; list non-standard subdomains explicitly.
CORS_ORIGIN=https://yourdomain.com

# Admin accounts
# Leave blank on first start — setup wizard at /admin/ will configure these.
# Generate hash: node -e "require('bcrypt').hash('yourpassword',12).then(console.log)"
# Do NOT wrap value in quotes — docker-compose env_file reads it literally.
ADMIN_USERNAME=
ADMIN_USERNAMES=
ADMIN_PASSWORD_HASH=

# WebUntis
WEBUNTIS_BASE=https://yourschool.webuntis.com/WebUntis
WEBUNTIS_SCHOOL=yourschool
# Display name of the school created for WEBUNTIS_SCHOOL on first start (every
# account from before schools existed belongs to it). Optional — WEBUNTIS_SCHOOL
# is used when empty; renamed in the panel (Schulen) afterwards.
DEFAULT_SCHOOL_NAME=
# Any school on WebUntis can use Pokyh: it is added the first time one of its
# accounts signs in through the trusted login (X-Server-Key; the login names
# the WebUntis school, its display name and server). New schools are active and
# have no Mensa plan until one is assigned in the panel. false: only schools
# that already exist can sign in.
SCHOOLS_AUTO_CREATE=true
# Safety net on the number of schools added that way.
SCHOOLS_MAX=1000
# WebUntis servers a school's login may name (host suffixes, comma separated).
WEBUNTIS_HOST_SUFFIXES=webuntis.com

# ─── WebUntis for the website (/webuntis/*) ──────────────────────────────────
# The website is a static page; it signs in here and this API talks to WebUntis
# with the person's own session. That session, and the sealed sign-in used to
# renew it, live only in httpOnly cookies on this API's address (pokyh_session,
# pokyh_renew, pokyh_api_refresh), never on the server. The website's origin
# must be listed in CORS_ORIGIN; it has to be on the same site as the API
# (pokyh.com → api.pokyh.com), or the browser will not send the cookies.
# Key that seals the cookies (AES-256-GCM). Empty: derived from JWT_SECRET.
# Changing it signs everybody out of the website once.
WEBUNTIS_SESSION_SECRET=
# Secure (HTTPS-only) cookies; true by default in production.
WEBUNTIS_COOKIE_SECURE=
# The public WebUntis school search behind the sign-in page.
WEBUNTIS_SCHOOL_SEARCH_URL=https://mobile.webuntis.com/ms/schoolquery2
# Optional: only these schools (WebUntis login names, comma separated) may sign in.
WEBUNTIS_SCHOOL_ALLOWLIST=
# Sign-ins per address and 5 minutes (a whole school shares one address), and
# per account and 15 minutes.
RATE_LIMIT_WEB_LOGIN_MAX=60
RATE_LIMIT_WEB_LOGIN_PER_ACCOUNT_MAX=10
# Messages one account may send to teachers (new ones, replies, excuses) per
# window; drafts do not count.
RATE_LIMIT_WEB_MESSAGE_MAX=30
RATE_LIMIT_WEB_MESSAGE_WINDOW_MS=900000
# Internal WebUntis paths that differ between instances (rarely needed):
# WEBUNTIS_API_PATH_ABSENCES, WEBUNTIS_API_PATH_ABSENCE_REASONS,
# WEBUNTIS_API_PATH_APPDATA, WEBUNTIS_API_PATH_MSG_LIST, WEBUNTIS_API_PATH_MSG_SENT,
# WEBUNTIS_API_PATH_MSG_DRAFTS, WEBUNTIS_API_PATH_MSG_RECIPIENTS,
# WEBUNTIS_PARENT_ROLE.
# Development only: offer absence reporting regardless of WebUntis' flag.
WEBUNTIS_FORCE_ABSENCE_REPORT=false

# ─── Read cache (Redis) ──────────────────────────────────────────────────────
# Menus, popups, to-dos, reminders, comments, ratings, subject images and the
# WebUntis school search are kept in Redis. Any write to a table drops its
# cached answers at once (also writes replicated from other cluster nodes and
# restores), so the cache never serves outdated data. MySQL stays the only
# source of truth. Docker Compose supplies redis://redis:6379; blank outside
# Compose: entries are kept in process memory instead.
REDIS_URL=
REDIS_KEY_PREFIX=pokyh:cache
CACHE_ENABLED=true
# Entries kept in process memory while Redis is unreachable.
CACHE_MEMORY_ENTRIES=2000
# Memory Redis may use (Compose); only cache entries are evicted.
REDIS_MAXMEMORY=256mb

# ─── Backups and recovery (see docs/database.md) ─────────────────────────────
# Where dumps are kept (the backups volume in Docker).
BACKUP_DIR=
BACKUP_ENABLED=true
# Hours between backups: 24 = once a day at BACKUP_SCHEDULE_HOUR (UTC);
# fewer back up more often (1 = hourly).
BACKUP_INTERVAL_HOURS=24
BACKUP_SCHEDULE_HOUR=3
BACKUP_RETENTION_DAYS=7
# What the server does when it starts with an empty database although this
# node had data (lost database volume): local = restore the newest local
# backup (default); offsite = also restore the newest off-site copy on a
# rebuilt server without local backups; off = never by itself.
DB_AUTO_RESTORE=local
# Encrypted off-site copies of every backup (any S3-compatible storage:
# Backblaze B2, Cloudflare R2, Hetzner, Wasabi, MinIO, AWS). Off until bucket,
# credentials and BACKUP_ENCRYPTION_KEY are set. Copies are encrypted on this
# server (AES-256-GCM) before they leave; keep the key somewhere else too —
# without it no copy can be restored (npm run decrypt-backup <file.enc>).
# Each node stores under BACKUP_S3_PREFIX/<CLUSTER_NODE_NAME or "main">/.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_S3_PREFIX=pokyh
BACKUP_ENCRYPTION_KEY=
BACKUP_OFFSITE_RETENTION_DAYS=30
BACKUP_OFFSITE_SYNC_MINUTES=10
BACKUP_OFFSITE_MAX_FILE_MB=2048
# Point-in-time recovery (db-archiver service): a base dump every
# PITR_BASE_HOURS, the binary log closed for archiving every PITR_FLUSH_MINUTES
# (at most that much is missing from the archive), kept PITR_RETENTION_DAYS.
PITR_BASE_HOURS=6
PITR_FLUSH_MINUTES=5
PITR_RETENTION_DAYS=14

# ─── Admin panel search (press "/" in the panel) ─────────────────────────────
# Searches accounts, classes, admins, dishes and comments of every school the
# admin's rights reach. Requests per admin and minute; results per kind (and
# when one kind is searched on its own).
ADMIN_SEARCH_PER_MINUTE=120
ADMIN_SEARCH_LIMIT=6
ADMIN_SEARCH_DETAIL_LIMIT=30

DEBUG=false

# ─── Auth / tokens (all optional — shown with their defaults) ────────────────
JWT_EXPIRES_IN=1h
ADMIN_JWT_EXPIRES_IN=7d
# Every admin panel account needs the authenticator app (2FA); only the server
# can switch that off. A passkey is optional: per account it can be made
# required under "Admins & Rechte"; ADMIN_REQUIRE_PASSKEY is the default for
# accounts without their own setting. Server owners (ADMIN_USERNAMES) always
# follow these two values.
ADMIN_REQUIRE_SECOND_FACTOR=true
ADMIN_REQUIRE_PASSKEY=false
REFRESH_TOKEN_EXPIRES_HOURS=1
# Device sessions: a device leaves an account's device list once unused this
# many days (a device signed out from elsewhere stays refused as long); at most
# this many devices per account. The login history is kept LOGIN_HISTORY_DAYS.
SESSION_IDLE_DAYS=60
SESSIONS_PER_ACCOUNT_MAX=20
LOGIN_HISTORY_DAYS=90
BCRYPT_ROUNDS=12

# ─── Rate limiting (requests per window; windows in ms) ──────────────────────
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
# Token refresh limiter (per IP). Generous on purpose: refresh is gated by an
# unguessable token, not a password, and whole schools share one NATed IP.
# Requests carrying a valid X-Server-Key bypass auth + refresh limiters entirely.
RATE_LIMIT_REFRESH_MAX=600
RATE_LIMIT_REFRESH_WINDOW_MS=900000
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=300
RATE_LIMIT_READ_WINDOW_MS=60000
# New live streams (/sse/*) per account, not per address: a school shares one.
RATE_LIMIT_SSE_MAX=30
RATE_LIMIT_SSE_WINDOW_MS=60000
RATE_LIMIT_ADMIN_LOGIN_MAX=10
RATE_LIMIT_ADMIN_LOGIN_WINDOW_MS=900000

# ─── Request body size limits ────────────────────────────────────────────────
BODY_LIMIT=10kb
BODY_LIMIT_UPLOAD=4mb
BODY_LIMIT_IMPORT=100mb
# ─── Background job intervals (ms) ───────────────────────────────────────────
PUSH_POLL_INTERVAL_MS=300000
PUSH_DUE_CHECK_INTERVAL_MS=60000
SESSION_CLEANUP_INTERVAL_MS=3600000

# ─── Audit / request-log retention ──────────────────────────────────────────
# Request logs contain technical personal data used for security and support.
# Keep both file and database retention finite; values are clamped to 1–365 days.
REQUEST_LOG_RETENTION_DAYS=30
REQUEST_LOG_CLEANUP_INTERVAL_MS=86400000
LOG_FILE_RETENTION_DAYS=30
# Admin audit trail (who changed what, every panel sign-in). At least 180 days
# (the Garante's measures on system administrators ask for six months).
AUDIT_RETENTION_DAYS=365

# ─── Error reports of the web app and the apps (POST /client-errors) ──────────
# Validated and scrubbed on the way in; no IP address, no account, no user
# agent string is stored. Per address and minute, and per identical error.
CLIENT_ERRORS_ENABLED=true
CLIENT_ERROR_RETENTION_DAYS=30
CLIENT_ERRORS_PER_MINUTE=20
CLIENT_ERRORS_PER_ERROR_PER_MINUTE=20

# ─── Usage analytics (admin Analytics page) ──────────────────────────────────
# The web, iOS and Android apps report one row per visit: device kind, foreground
# time and screen count — no IP address or user agent. A visit names its account
# only with the account's opt-in consent and only for the retention below
# (30–365 days; ACCOUNT_ACTIVITY_SCHOOL_YEAR below keeps it for the school year instead, as the privacy notice states); otherwise it is anonymous (a
# day-scoped visitor key) and only feeds the aggregate figures. Rows are
# grouped by day/hour in ANALYTICS_TIMEZONE. Page views keep names only with
# that consent and are deleted after REQUEST_LOG_RETENTION_DAYS.
ANALYTICS_TIMEZONE=Europe/Rome
USAGE_ANALYTICS_RETENTION_DAYS=90
# An account's active days, device kinds and sign-ins per day, and (with
# consent) the link of its visits to it, are kept for the running school year
# and archived per account at the rollover. false: the periods above apply.
ACCOUNT_ACTIVITY_SCHOOL_YEAR=true

# ─── Archiving of expired todos/reminders ────────────────────────────────────
ARCHIVE_AFTER_HOURS=24
ARCHIVE_CHECK_INTERVAL_MS=3600000

# ─── School year rollover ─────────────────────────────────────────────────────
# On the configured date (default Aug 1) all non-admin users, classes, todos and
# reminders are snapshotted into the school_years archive tables and the live
# tables are cleared so the new year starts fresh. Set AUTO=false to disable.
SCHOOL_YEAR_ROLLOVER_AUTO=true
SCHOOL_YEAR_ROLLOVER_CHECK_INTERVAL_MS=3600000
# Month (1-12) and day for the rollover. Defaults to August 1st.
SCHOOL_YEAR_ROLLOVER_MONTH=8
SCHOOL_YEAR_ROLLOVER_DAY=1

# ─── In-memory cache TTL (ms) ────────────────────────────────────────────────
CACHE_TTL_MS=300000

# ─── Misc ────────────────────────────────────────────────────────────────────
SSE_HEARTBEAT_MS=30000
# Address of the menu source (a mensa.json) for "Import" in the admin panel's
# dish page; empty = enter it in the import dialog.
MENSA_IMPORT_URL=
PUBLIC_BASE_URL=

# ─── Cluster (multi-node replication) ────────────────────────────────────────
# Optional. Nothing here is needed for a single server, and nothing takes
# effect until an invite is created or used in the admin panel (Cluster).
# There is no leader: every node accepts writes and holds all data. See README.md.
CLUSTER_ENABLED=true
# Shown to the other nodes. Defaults to the host name.
CLUSTER_NODE_NAME=
# The address the other nodes reach this one at, e.g. https://node1.example.org
# (through the reverse proxy) or http://10.0.0.5:4100 (CLUSTER_PORT). Prefills
# the invite and join forms; when set it cannot be changed in the panel.
CLUSTER_ADVERTISE_URL=
# Where the node-to-node channel is served — both may be on at once:
#   CLUSTER_PUBLIC_PATH  /cluster/v1 on the ordinary API port (reverse proxy)
#   CLUSTER_PORT         a listener of its own that serves nothing else (0 = off),
#                        bound to CLUSTER_BIND_ADDRESS
CLUSTER_PUBLIC_PATH=true
CLUSTER_PORT=0
CLUSTER_BIND_ADDRESS=0.0.0.0
# The mutually authenticated channel: TLS 1.3 with a certificate of this node's
# own on both ends, peers pinned, nothing else accepted (0 = off). Needed for
# the one-line installer (Cluster → "Server per Einzeiler hinzufügen"); 4100 by
# convention. CLUSTER_MTLS_URL is how the other nodes reach it — it must reach
# this server directly, not a proxy that ends TLS (empty = host of
# CLUSTER_ADVERTISE_URL or PUBLIC_BASE_URL with this port). With Docker Compose
# or Dokploy also set CLUSTER_MTLS_PUBLISH=0.0.0.0:4100 to publish the port.
CLUSTER_MTLS_PORT=0
CLUSTER_MTLS_URL=
CLUSTER_MTLS_BIND_ADDRESS=0.0.0.0
CLUSTER_MTLS_PUBLISH=
# Further ways to reach this node, in order, comma separated (more can be set
# in the admin panel): a VPN address, a proxy's own port, or a proxy on 443
# routing by name, e.g.
#   https://10.8.0.2:4100,https://vps.example.org:4100,https://node1.cluster.example.org:443
# Proxies must pass the connection on unchanged (never terminate TLS).
CLUSTER_MTLS_ENDPOINTS=
# Pokyh relays this node registers at (keys from "Relay auf VPS einrichten",
# comma separated). Relays added in the admin panel apply to every node.
CLUSTER_RELAY_KEYS=
# The name this node is registered under at relays (default: from its name).
CLUSTER_RELAY_LABEL=
CLUSTER_RELAY_POOL_SIZE=4
# The port a relay listens on locally when its key does not name one (the relay
# installer's --port default) — used for the proxy configuration shown.
CLUSTER_RELAY_DEFAULT_PORT=4100
# Ways through this node's own web proxy on the API's public address, comma
# separated, e.g. https://api.example.org/cluster-node/homelab — the proxy ends
# TLS and passes the path (prefix removed) to this node's cluster entry (the API
# port with CLUSTER_PUBLIC_PATH, or CLUSTER_PORT). No certificate pinning on
# this way (frames stay end-to-end encrypted and authenticated), so the others
# use it only when every pinned way fails. Also settable in the admin panel.
CLUSTER_PATH_ENDPOINTS=
# After the channel to a peer failed, how long calls take another way before
# the channel is tried again.
CLUSTER_CHANNEL_RETRY_SECONDS=60
# A forwarder in front of the channel port names each client in a PROXY
# protocol line (servers set up by the installer: on). Accepted only from
# these ranges (default: private and loopback addresses).
CLUSTER_MTLS_PROXY_PROTOCOL=false
CLUSTER_MTLS_PROXY_FROM=
# How long a one-line install command can be started after it was created.
# Only meanwhile does /setup exist; otherwise it answers 404.
CLUSTER_INSTALL_TTL_MINUTES=30

# ─── Updates (src/cluster/updates.ts) ────────────────────────────────────────
# The git repository and branch new versions come from (https; any git host).
# Empty = no automatic updates. Can also be set in the admin panel (Cluster →
# Updates); the panel's setting then applies to every node.
CLUSTER_UPDATE_REPO=
CLUSTER_UPDATE_BRANCH=main
# Roll new versions out by themselves (false: they wait for "Jetzt ausrollen").
CLUSTER_UPDATE_AUTO=true
# Only commits whose GitHub checks all passed (github.com repositories only).
# The repository itself runs no checks; turn this on only where the update
# branch has some, otherwise no version is ever rolled out.
CLUSTER_UPDATE_REQUIRE_CI=false
CLUSTER_UPDATE_POLL_MINUTES=2
# A node unreachable this long is passed over in a rollout.
CLUSTER_UPDATE_SKIP_OFFLINE_MINUTES=10
# How long a new version may take to become healthy before the node stays on
# the previous one.
CLUSTER_UPDATE_HEALTH_TIMEOUT_SECONDS=300
# Optional, this node only: a read-only GitHub token for more API requests
# when checking the checks. Public repositories work without one.
CLUSTER_UPDATE_GITHUB_TOKEN=
# Set by the installer's stack (blue/green updates); leave empty elsewhere.
POKYH_COLOR=
POKYH_UPDATE_DIR=
POKYH_ACTIVATION_FILE=
# Only these addresses (IPs or CIDR ranges, comma-separated) may use the
# channel, on both entry points. Empty = any address (every frame is still
# end-to-end encrypted and authenticated). Behind a reverse proxy the address
# is the one TRUST_PROXY lets through.
CLUSTER_ALLOWLIST=
# A node joining through one member is introduced to all the others.
CLUSTER_AUTO_MESH=true
# Protects the stored link keys. When empty, a key derived from JWT_SECRET is
# used. Changing it (or JWT_SECRET while this is empty) makes stored link keys
# unreadable, and the affected nodes have to be invited again.
CLUSTER_SECRET=
# Failure detection: a heartbeat every INTERVAL; a peer is reported as not
# answering after SUSPECT and as offline after OFFLINE consecutive failures.
CLUSTER_HEARTBEAT_INTERVAL_MS=5000
CLUSTER_REQUEST_TIMEOUT_MS=4000
CLUSTER_SUSPECT_AFTER_FAILURES=2
CLUSTER_OFFLINE_AFTER_FAILURES=4
# How often the change feed is looked at (reads only, on an index).
CLUSTER_SYNC_INTERVAL_MS=250
CLUSTER_SYNC_TIMEOUT_MS=60000
# Adaptive batching: a change goes out once the feed was quiet for IDLE ms;
# under load changes are collected for at most MAX_DELAY ms (or BATCH_SIZE
# rows) and sent as one compressed package.
CLUSTER_BATCH_IDLE_MS=500
CLUSTER_BATCH_MAX_DELAY_MS=2000
CLUSTER_BATCH_SIZE=500
# Upper bound for one message between nodes; must exceed the largest row.
CLUSTER_MAX_MESSAGE_BYTES=16777216
# Longest a writing transaction may stay open; the change feed re-reads this
# span so a late commit is never skipped.
CLUSTER_COMMIT_HORIZON_MS=300000
# How often the nodes compare checksums of all their data and repair what differs.
CLUSTER_VERIFY_INTERVAL_MINUTES=15
# An invite code is valid this long, once, and locks after this many wrong attempts.
CLUSTER_PAIRING_TTL_MINUTES=15
CLUSTER_PAIRING_MAX_FAILURES=5
# Clock difference between nodes above which the admin panel warns.
CLUSTER_MAX_CLOCK_SKEW_MS=10000
# How long a deletion is remembered for peers that are away. A peer away for
# longer is put on hold until an administrator decides.
CLUSTER_TOMBSTONE_RETENTION_DAYS=30
# How long a received change may wait for the row it depends on.
CLUSTER_DEFERRED_MAX_AGE_HOURS=72
# Additional tables to keep on this node only (comma-separated).
CLUSTER_EXCLUDE_TABLES=
