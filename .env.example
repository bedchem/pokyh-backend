NODE_ENV=production
PORT=4000

# Express trust-proxy setting. Behind the Cloudflare tunnel the client IP comes
# via X-Forwarded-For; this declares how many/which proxies to trust so rate
# limiting works (default 'loopback'). Use 'true', 'false', a hop count, or a
# named value. Set to a number (e.g. 2) if you add Traefik/another proxy hop.
TRUST_PROXY=loopback

# MySQL (matches docker-compose service name — do NOT change to localhost)
DATABASE_URL=mysql://root:CHANGE_ME@mysql:3306/pokyh
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Discrete DB connection fields. If DATABASE_URL is left blank it is built from
# these (user/password URL-encoded automatically). DATABASE_URL wins when set.
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=pokyh
DB_CONNECTION_LIMIT=20
DB_AUTO_PUSH=true
DB_PUSH_TIMEOUT_MS=120000
DB_CONNECT_BASE_DELAY_MS=2000
DB_CONNECT_MAX_DELAY_MS=30000

# JWT / API secrets — generate each with: openssl rand -hex 32
JWT_SECRET=
REFRESH_TOKEN_SECRET=
API_KEY=
SERVER_KEY=

# CORS — comma-separated browser origins, no trailing slash. The API accepts
# the corresponding www/apex alias too; list non-standard subdomains explicitly.
CORS_ORIGIN=https://yourdomain.com

# Learn browser origins — direct browser calls to /learn are accepted only from
# this explicit allow-list. The learn.pokyh.com BFF itself calls the API
# server-to-server and is authenticated separately by API key + bearer token.
LEARN_ALLOWED_ORIGINS=https://learn.pokyh.com

# Legal activation gate for the independent Pokyh Learn/WebUntis integration.
# Production defaults to requiring this information even when omitted. Record a
# non-secret internal approval reference, publish an Article 13 privacy notice,
# and use the same version in the Learn frontend before enabling sign-in.
LEARN_LEGAL_GATE_ENABLED=true
LEARN_WEBUNTIS_AUTHORIZATION_REFERENCE=
LEARN_PRIVACY_NOTICE_URL=https://pokyh.com/legal?view=learn
LEARN_PRIVACY_NOTICE_VERSION=2026-09-12

# Optional vocabulary suggestion provider. Keep this disabled until its
# privacy, attribution and availability policy has been reviewed. It is used
# only when an authorized editor explicitly requests a suggestion; an author
# saved answer remains the sole quiz-grading authority.
LEARN_DICTIONARY_ENABLED=false
LEARN_DICTIONARY_PROVIDER=mymemory
LEARN_DICTIONARY_BASE_URL=https://api.mymemory.translated.net
LEARN_DICTIONARY_CONTACT_EMAIL=
LEARN_DICTIONARY_ALLOWED_PAIRS=it:de,en:de,de:it,de:en
LEARN_DICTIONARY_TIMEOUT_MS=4000
LEARN_DICTIONARY_CACHE_TTL_MS=3600000
LEARN_DICTIONARY_MAX_CACHE_ENTRIES=500

# Optional lexical validation through the free Dictionary API. Its documented
# endpoint is English-only; it must never be presented as German/Italian
# translation validation. When disabled/unavailable, Learn keeps the word and
# marks it for an editor rather than losing the learner's contribution.
LEARN_DICTIONARY_VALIDATION_ENABLED=false
LEARN_DICTIONARY_VALIDATION_PROVIDER=dictionaryapi
LEARN_DICTIONARY_VALIDATION_BASE_URL=https://api.dictionaryapi.dev/api/v2
LEARN_DICTIONARY_VALIDATION_TIMEOUT_MS=4000
LEARN_DICTIONARY_VALIDATION_CACHE_TTL_MS=86400000
LEARN_DICTIONARY_VALIDATION_MAX_CACHE_ENTRIES=1000

# Network egress policy for both vocabulary providers. This is intentionally
# environment-only and must never contain localhost, private addresses, or an
# unreviewed host.
LEARN_DICTIONARY_ALLOWED_HOSTS=api.dictionaryapi.dev,api.mymemory.translated.net

# Self-hosted, CPU-only Ollama vocabulary trainer. Disabled by default. Even
# when enabled, access additionally requires a per-user LearnAiAccessGrant
# (pilot allowlist) — this flag alone never exposes the trainer to anyone.
# The model runs entirely inside the internal Docker network; the base URL
# stays pointed at the `ollama` service, never a public host.
LEARN_AI_ENABLED=false
LEARN_AI_MODEL=gemma4:e4b
LEARN_AI_CONTEXT_TOKENS=4096
LEARN_AI_NUM_PREDICT_FAST=512
LEARN_AI_RATE_LIMIT_MESSAGES_PER_HOUR=30
# The vocabulary trainer has a server-side cap before requests reach Ollama.
# Keep this aligned with OLLAMA_NUM_PARALLEL after load-testing the host.
LEARN_AI_MAX_CONCURRENT_TRAINING_GENERATIONS=10
LEARN_AI_OLLAMA_BASE_URL=http://ollama:11434
# 180s default: a CPU-only cold start (loading the model into memory before
# the first training sentence since boot/idle-unload) measured ~150s on modest hardware
# in testing — a warm call (model already resident) is much faster.
LEARN_AI_OLLAMA_TIMEOUT_MS=180000

# Network egress policy for the trainer. Environment-only, like the
# dictionary allow-list above — must never contain a public/external host.
LEARN_AI_ALLOWED_HOSTS=ollama

# Ollama container resource/tuning knobs (compose.yaml `ollama` service).
# These are NOT read by the Node app — they configure the Ollama container
# itself and Docker's own resource limits for it. Unlike every other variable
# in this file, they only reach the deployed stack through
# scripts/compose-stack.sh, which extracts this specific small set of
# non-secret keys and exports them as real shell variables before invoking
# `docker compose` (Compose's own ${VAR} substitution needs a real
# environment variable here, since this script disables Compose's automatic
# .env parsing to protect `$`-containing secrets elsewhere in this file).
# Size mem_limit/cpus to leave real headroom for MySQL/Redis/the app/OS on
# the same host — do not give Ollama the box's entire RAM/CPU budget.
# The supplied Docker defaults deliberately match a four-vCPU host.  Keep
# memory at 10GB for the resident Gemma model plus request/context overhead;
# do not enable this profile on a host that cannot provide that headroom.
OLLAMA_MEM_LIMIT=10g
OLLAMA_CPUS=4
OLLAMA_NUM_THREAD=4
# Ten in-flight vocabulary-sentence requests are accepted; Ollama queues them
# fairly on this CPU-only runtime. Keep this aligned with the app-level cap
# above, and load-test before increasing it on a small host.
OLLAMA_NUM_PARALLEL=10
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=30m

# Personal Learn JSON portability limits. Imports are validated, remapped into
# new private drafts, and cannot transfer teams, grants, roles or credentials.
LEARN_IMPORT_MAX_COURSES=20
LEARN_IMPORT_MAX_SECTIONS_PER_COURSE=100
LEARN_IMPORT_MAX_VOCABULARY_PER_COURSE=1000

# Adaptive review and first-party learning analytics. The backend owns the
# schedule; clients never submit a score, next-review date or analytics row.
# Aggregates contain only daily counts per learner/course, not answer text.
LEARN_REVIEW_INITIAL_INTERVAL_DAYS=1
LEARN_REVIEW_MAX_INTERVAL_DAYS=120
LEARN_REVIEW_MINIMUM_EASE=1.3
LEARN_REVIEW_MAXIMUM_EASE=3
LEARN_REVIEW_CORRECT_EASE_STEP=0.05
LEARN_REVIEW_INCORRECT_EASE_PENALTY=0.2
# Zero makes a missed word immediately available for focused recovery.
LEARN_REVIEW_WRONG_DELAY_MINUTES=0
# Retain compact per-day aggregates for this bounded period. Align this with
# the approved privacy notice/retention schedule before production.
LEARN_ANALYTICS_RETENTION_DAYS=365

# Optional Redis cache for private, course-specific Learn analytics. MySQL is
# always authoritative; leave blank to run without Redis. Do not expose Redis
# to the public network or use it for tokens, answer keys or permissions.
# Docker Compose supplies redis://redis:6379 when this is left blank. For a
# non-Compose deployment set an authenticated redis:// or rediss:// URL here.
LEARN_REDIS_URL=
LEARN_REDIS_KEY_PREFIX=pokyh:learn
LEARN_ANALYTICS_CACHE_TTL_SECONDS=60

# Admin accounts
# Leave blank on first start — setup wizard at /admin/ will configure these.
# Generate hash: node -e "require('bcrypt').hash('yourpassword',12).then(console.log)"
# Do NOT wrap value in quotes — docker-compose env_file reads it literally.
ADMIN_USERNAME=
ADMIN_USERNAMES=
ADMIN_PASSWORD_HASH=

# WebUntis
WEBUNTIS_BASE=https://yourschool.webuntis.com/WebUntis
WEBUNTIS_SCHOOL=yourschool

DEBUG=false

# ─── Auth / tokens (all optional — shown with their defaults) ────────────────
JWT_EXPIRES_IN=1h
ADMIN_JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_HOURS=1
BCRYPT_ROUNDS=12

# ─── Rate limiting (requests per window; windows in ms) ──────────────────────
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
# Token refresh limiter (per IP). Generous on purpose: refresh is gated by an
# unguessable token, not a password, and whole schools share one NATed IP.
# Requests carrying a valid X-Server-Key bypass auth + refresh limiters entirely.
RATE_LIMIT_REFRESH_MAX=600
RATE_LIMIT_REFRESH_WINDOW_MS=900000
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=300
RATE_LIMIT_READ_WINDOW_MS=60000
RATE_LIMIT_SSE_MAX=10
RATE_LIMIT_SSE_WINDOW_MS=60000
RATE_LIMIT_ADMIN_LOGIN_MAX=10
RATE_LIMIT_ADMIN_LOGIN_WINDOW_MS=900000

# ─── Request body size limits ────────────────────────────────────────────────
BODY_LIMIT=10kb
BODY_LIMIT_UPLOAD=4mb
BODY_LIMIT_IMPORT=100mb
# ─── Background job intervals (ms) ───────────────────────────────────────────
PUSH_POLL_INTERVAL_MS=300000
PUSH_DUE_CHECK_INTERVAL_MS=60000
SESSION_CLEANUP_INTERVAL_MS=3600000

# ─── Audit / request-log retention ──────────────────────────────────────────
# Request logs contain technical personal data used for security and support.
# Keep both file and database retention finite; values are clamped to 1–365 days.
REQUEST_LOG_RETENTION_DAYS=30
REQUEST_LOG_CLEANUP_INTERVAL_MS=86400000
LOG_FILE_RETENTION_DAYS=30

# ─── Archiving of expired todos/reminders ────────────────────────────────────
ARCHIVE_AFTER_HOURS=24
ARCHIVE_CHECK_INTERVAL_MS=3600000

# ─── School year rollover ─────────────────────────────────────────────────────
# On the configured date (default Aug 1) all non-admin users, classes, todos and
# reminders are snapshotted into the school_years archive tables and the live
# tables are cleared so the new year starts fresh. Set AUTO=false to disable.
SCHOOL_YEAR_ROLLOVER_AUTO=true
SCHOOL_YEAR_ROLLOVER_CHECK_INTERVAL_MS=3600000
# Month (1-12) and day for the rollover. Defaults to August 1st.
SCHOOL_YEAR_ROLLOVER_MONTH=8
SCHOOL_YEAR_ROLLOVER_DAY=1

# ─── In-memory cache TTL (ms) ────────────────────────────────────────────────
CACHE_TTL_MS=300000

# ─── Misc ────────────────────────────────────────────────────────────────────
SSE_HEARTBEAT_MS=30000
MENSA_IMPORT_URL=https://mensa.plattnericus.dev/mensa.json
PUBLIC_BASE_URL=
