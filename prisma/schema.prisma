// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(uuid())
  stableUid          String   @unique @map("stable_uid")
  username           String   @unique
  webuntisKlasseId   Int      @default(0) @map("webuntis_klasse_id")
  webuntisKlasseName String   @default("") @map("webuntis_klasse_name")
  passwordHash       String?  @map("password_hash") @db.VarChar(100)
  isUntisUser        Boolean  @default(true) @map("is_untis_user")
  // Account role: "student" (default) or "parent". Parents have their own todos,
  // no class identity/membership and no reminders.
  role               String   @default("student") @db.VarChar(20)
  // The school the account belongs to (schools.id). Set at sign-in from the
  // WebUntis school the account signed in with; every account that existed
  // before schools were introduced belongs to the default school.
  schoolId           String?  @map("school_id") @db.VarChar(36)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  todos                   Todo[]
  classMembers            ClassMember[]
  refreshTokens           RefreshToken[]
  loginEvents             LoginEvent[]
  pushSubscriptions       PushSubscription[]
  // Pokyh Learn is deliberately attached to the existing POKYH identity.  A
  // profile is created lazily on first Learn use, which also marks this account
  // as persistent across the school-year cleanup.
  learnProfile            LearnProfile?
  learnCoursesCreated     LearnCourse[]            @relation("LearnCourseCreator")
  learnCourseAccesses     LearnCourseAccess[]
  learnEnrollments        LearnEnrollment[]
  learnVocabularyEntries  LearnVocabularyEntry[]   @relation("LearnVocabularyCreator")
  learnVocabularyReviews  LearnVocabularyReview[]
  learnQuizAttempts       LearnQuizAttempt[]
  // Privacy-preserving, per-day learning aggregates. These retain counts and
  // dates, not answer text, and power the learner's own analytics screen.
  learnActivityDays       LearnActivityDaily[]
  learnTeamsCreated       LearnTeam[]              @relation("LearnTeamCreator")
  learnTeamMemberships    LearnTeamMember[]
  learnSectionCompletions LearnSectionCompletion[]
  learnAiAccessGrant      LearnAiAccessGrant?
  learnAiUsageCounters    LearnAiUsageCounter[]
  learnAiTrainingPrompts  LearnAiTrainingPrompt[]
  usageSessions           UsageSession[]
  webVisits               WebVisit[]
  privacyConsent          PrivacyConsent?
  popupTargets            PopupTargetUser[]
  recapTargets            RecapTargetUser[]
  recapViews              RecapView[]
  bellMarks               BellMark[]

  @@index([schoolId, createdAt])
  @@index([schoolId, role])
  @@map("users")
}

model PushSubscription {
  id          String   @id @default(uuid())
  stableUid   String   @map("stable_uid")
  endpoint    String   @unique @db.VarChar(500)
  p256dh      String   @db.VarChar(255)
  auth        String   @db.VarChar(255)
  jsessionid  String   @db.VarChar(100)
  bearerToken String   @map("bearer_token") @db.VarChar(1000)
  knownUnread Int      @default(-1) @map("known_unread")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@map("push_subscriptions")
}

// The bell in the website's top bar: which of its notifications an account
// has seen or cleared away, so every device shows the same. Only the
// notification's identifier is kept ("grade:4711", "msg:12",
// "todo:<id>:<due>") — never a grade, a subject or a text. Deleted after
// BELL_MARK_RETENTION_DAYS (services/bellMarks.ts; the bell reaches back 14
// days) and with the account.
model BellMark {
  stableUid String   @map("stable_uid")
  key       String   @db.VarChar(120)
  // Cleared away (and so also seen); otherwise only seen.
  cleared   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@id([stableUid, key])
  @@index([createdAt])
  @@map("bell_marks")
}

model Admin {
  stableUid          String    @id @map("stable_uid")
  canCreateClass     Boolean   @default(true) @map("can_create_class")
  passwordHash       String?   @map("password_hash") @db.VarChar(100)
  // A WebUntis account made admin in the panel has no password of its own:
  // the granting admin sets a one-time password (passwordHash), the new admin
  // must replace it at the first login. Without that login before
  // setupExpiresAt, the grant lapses and this row — with the one-time
  // password — is removed.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  setupExpiresAt     DateTime? @map("setup_expires_at")
  // The one-time password, sealed with a key derived from JWT_SECRET, so the
  // admin who granted it (grantedBy, their login name) can show it again
  // while the grant is pending. Cleared once the new admin has their own.
  oneTimePasswordEnc String?   @map("one_time_password_enc") @db.VarChar(255)
  grantedBy          String?   @map("granted_by") @db.VarChar(191)
  createdAt          DateTime  @default(now()) @map("created_at")

  @@map("admins")
}

// Second factors of the admin panel login. Keyed by the admin login name —
// the identity the admin JWT carries — so an env-configured admin without a
// users row can use them as well. Once an admin has any of them, the password
// alone no longer opens the panel.
model AdminTotp {
  username         String    @id @db.VarChar(191)
  // The base32 secret, sealed with a key derived from JWT_SECRET.
  secretEnc        String    @map("secret_enc") @db.VarChar(255)
  // Moving to a new device: the new secret, sealed the same way, until a code
  // from the new device confirms it. The old one keeps working meanwhile.
  pendingSecretEnc String?   @map("pending_secret_enc") @db.VarChar(255)
  // Null while the set-up waits for its first correct code.
  enabledAt        DateTime? @map("enabled_at")
  // The last accepted 30-second step: a code is never accepted twice.
  lastUsedStep     Int       @default(0) @map("last_used_step")
  // JSON array of SHA-256 hashes of the unused one-time recovery codes.
  recoveryCodes    String    @map("recovery_codes") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("admin_totp")
}

// Login security of an admin panel account, keyed by the login name like the
// second factors (a server owner has no users row). The authenticator app is
// required for everyone (ADMIN_REQUIRE_SECOND_FACTOR); requirePasskey says
// whether this account also needs a passkey, null: the server default
// (ADMIN_REQUIRE_PASSKEY). The last panel login is kept here, so the admin
// list can show it without reading the audit trail (which is only the
// fallback for logins before this table existed).
model AdminSecurity {
  username        String    @id @db.VarChar(191)
  requirePasskey  Boolean?  @map("require_passkey")
  // Login name of the admin who last set requirePasskey.
  changedBy       String?   @map("changed_by") @db.VarChar(191)
  lastLoginAt     DateTime? @map("last_login_at")
  // How: "password", "password+totp", "password+passkey", "passkey", …
  lastLoginMethod String?   @map("last_login_method") @db.VarChar(40)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("admin_security")
}

model AdminPasskey {
  id           String    @id @default(uuid())
  username     String    @db.VarChar(191)
  // WebAuthn credential id, base64url.
  credentialId String    @unique @map("credential_id") @db.VarChar(512)
  // COSE public key, base64url.
  publicKey    String    @map("public_key") @db.Text
  counter      BigInt    @default(0)
  transports   String    @default("") @db.VarChar(255)
  // The domain the passkey was made for; it only works under that domain.
  rpId         String    @map("rp_id") @db.VarChar(255)
  name         String    @db.VarChar(100)
  backedUp     Boolean   @default(false) @map("backed_up")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  @@index([username])
  @@map("admin_passkeys")
}

model Class {
  id               String   @id
  name             String
  code             String   @unique @db.Char(6)
  webuntisKlasseId Int      @map("webuntis_klasse_id")
  createdBy        String   @map("created_by")
  createdByName    String   @map("created_by_name")
  // WebUntis class ids are per school; so are classes.
  schoolId         String?  @map("school_id") @db.VarChar(36)
  createdAt        DateTime @default(now()) @map("created_at")

  members   ClassMember[]
  reminders Reminder[]

  @@index([schoolId, webuntisKlasseId])
  @@map("classes")
}

model ClassMember {
  classId   String   @map("class_id")
  stableUid String   @map("stable_uid")
  username  String
  // Parent rows are forbidden by the API; the role remains for compatibility
  // while older deployments are reconciled through login/admin role changes.
  role      String   @default("student") @db.VarChar(20)
  joinedAt  DateTime @default(now()) @map("joined_at")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@id([classId, stableUid])
  @@index([stableUid])
  @@map("class_members")
}

model Todo {
  id         String    @id @default(uuid())
  stableUid  String    @map("stable_uid")
  title      String    @db.VarChar(500)
  details    String    @default("") @db.VarChar(5000)
  dueAt      DateTime? @map("due_at")
  done       Boolean   @default(false)
  doneAt     DateTime? @map("done_at")
  notifiedAt DateTime? @map("notified_at")
  // Set once a todo has been expired (overdue) for >24h. Archived todos are
  // hidden from users and live on the server only — viewable by admins.
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@index([stableUid, archivedAt])
  @@index([archivedAt])
  // Speeds the per-minute "due todos" notification scan.
  @@index([notifiedAt, dueAt])
  @@map("todos")
}

model Reminder {
  id                String    @id @default(uuid())
  classId           String    @map("class_id")
  title             String    @db.VarChar(500)
  body              String    @default("") @db.VarChar(5000)
  remindAt          DateTime  @map("remind_at")
  createdBy         String    @map("created_by")
  createdByName     String    @map("created_by_name")
  createdByUsername String    @map("created_by_username")
  notifiedAt        DateTime? @map("notified_at")
  // Set once a reminder has been expired for >24h. Archived reminders are hidden
  // from class members and live on the server only — viewable by admins.
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([classId, archivedAt])
  @@index([archivedAt])
  // Speeds the per-minute "due reminders" notification scan.
  @@index([notifiedAt, remindAt])
  @@map("reminders")
}

model Comment {
  id         String   @id @default(uuid())
  reminderId String   @map("reminder_id")
  classId    String   @map("class_id")
  stableUid  String   @map("stable_uid")
  username   String
  body       String   @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId])
  @@map("comments")
}

model DishComment {
  id        String   @id @default(uuid())
  dishId    String   @map("dish_id")
  stableUid String   @map("stable_uid")
  username  String
  body      String   @db.VarChar(2000)
  // The menu the dish belongs to (comments are shown per menu) and the
  // author's school (moderation is per school).
  menuId    String?  @map("menu_id") @db.VarChar(36)
  schoolId  String?  @map("school_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dishId])
  @@index([menuId, dishId])
  @@index([schoolId, createdAt])
  @@map("dish_comments")
}

model Dish {
  id           String   @id @default(uuid())
  nameDe       String   @map("name_de") @db.VarChar(500)
  nameIt       String   @default("") @map("name_it") @db.VarChar(500)
  nameEn       String   @default("") @map("name_en") @db.VarChar(500)
  descDe       String   @default("") @map("desc_de") @db.VarChar(2000)
  descIt       String   @default("") @map("desc_it") @db.VarChar(2000)
  descEn       String   @default("") @map("desc_en") @db.VarChar(2000)
  imageUrl     String   @default("") @map("image_url") @db.VarChar(1000)
  category     String   @default("") @db.VarChar(200)
  tags         String   @default("[]") @db.VarChar(2000)
  prepTime     Int      @default(0) @map("prep_time")
  calories     Int      @default(0)
  price        Float    @default(0)
  protein      Float    @default(0)
  fat          Float    @default(0)
  allergens    String   @default("[]") @db.VarChar(2000)
  isVegetarian Boolean  @default(false) @map("is_vegetarian")
  isVegan      Boolean  @default(false) @map("is_vegan")
  date         DateTime @db.Date
  sortOrder    Int      @default(0) @map("sort_order")
  plan         String   @default("summer") @db.VarChar(10)
  sourceId     String?  @map("source_id") @db.VarChar(200)
  // Stable slug derived from nameDe. Ratings and comments reference this key,
  // so re-imports (which regenerate the internal id) or same-name dishes in
  // both plans share bewertungen/kommentare automatically.
  stableKey    String   @default("") @map("stable_key") @db.VarChar(200)
  // Cycle-position of the dish's week (1..N). Set at import (parsed from
  // sourceId like "w6_mo" or inferred from date order) and NEVER changed by
  // anchor/rotate. The UI labels weeks by this ordinal, so Woche 1's content
  // keeps being Woche 1 even after rotation puts it later in the calendar.
  weekOrdinal  Int      @default(0) @map("week_ordinal")
  // The menu (mensa_menus) this dish is part of. A school sees the dishes of
  // the one menu assigned to it, and nothing when none is.
  menuId       String?  @map("menu_id") @db.VarChar(36)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([menuId, plan, date])
  @@index([plan, date])
  @@index([plan, sourceId])
  @@index([stableKey])
  @@map("dishes")
}

model DishImage {
  dishId    String   @id @map("dish_id")
  data      Bytes    @db.LongBlob
  mimeType  String   @map("mime_type") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dish_images")
}

model DishRating {
  dishId    String   @map("dish_id")
  stableUid String   @map("stable_uid")
  // Account name at rating time. A stableUid changes when the user row is
  // recreated (school-year rollover, database rebuild); the username lets the
  // vote be reclaimed so nobody can rate the same dish twice.
  username  String?  @db.VarChar(100)
  stars     Int
  // As on dish_comments: the menu the vote counts in, the voter's school.
  menuId    String?  @map("menu_id") @db.VarChar(36)
  schoolId  String?  @map("school_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([dishId, stableUid])
  @@index([username])
  @@index([menuId, dishId])
  @@index([schoolId])
  @@map("dish_ratings")
}

// One signed-in device of an account (services/sessions.ts). The refresh token
// is rotated in place, so the row — its id is the access token's `sid` — stays
// the same device for as long as it is signed in. The device and place
// details are shown to the account itself (its device list) and to admins,
// and go with the row: when the device signs out, is signed out, or stays
// unused for SESSION_IDLE_DAYS.
model RefreshToken {
  id         String    @id @default(uuid())
  stableUid  String    @map("stable_uid")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")
  // The device id the app or the website's device cookie sent; null for
  // clients that send none (older apps, the Learn BFF).
  deviceId   String?   @map("device_id") @db.VarChar(64)
  // "app" | "pwa" | "web" | "other" (services/sessionDevice.ts)
  client     String    @default("") @db.VarChar(8)
  // "android" | "ios" | "windows" | "macos" | "linux" | "chromeos" | "other"
  platform   String    @default("") @db.VarChar(10)
  os         String    @default("") @db.VarChar(40)
  browser    String    @default("") @db.VarChar(40)
  model      String    @default("") @db.VarChar(60)
  // Where the device was last seen: address and the edge's coarse location.
  ip         String?   @db.VarChar(45)
  country    String    @default("") @db.VarChar(2)
  region     String?   @db.VarChar(80)
  city       String?   @db.VarChar(80)
  lastUsedAt DateTime  @default(now()) @map("last_used_at")

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@index([stableUid, deviceId])
  @@map("refresh_tokens")
}

// The account's sign-ins (its login history), kept LOGIN_HISTORY_DAYS. Only
// sign-ins by the person: the website's automatic renewals are not one.
model LoginEvent {
  id        String   @id @default(uuid()) @db.VarChar(36)
  stableUid String   @map("stable_uid")
  createdAt DateTime @default(now()) @map("created_at")
  // "webuntis" (password), "office" (app key), "local" (POKYH account), "register"
  method    String   @default("webuntis") @db.VarChar(12)
  // The device session the sign-in opened (refresh_tokens.id); it may be gone.
  sessionId String?  @map("session_id") @db.VarChar(36)
  client    String   @default("") @db.VarChar(8)
  platform  String   @default("") @db.VarChar(10)
  os        String   @default("") @db.VarChar(40)
  browser   String   @default("") @db.VarChar(40)
  model     String   @default("") @db.VarChar(60)
  ip        String?  @db.VarChar(45)
  country   String   @default("") @db.VarChar(2)
  region    String?  @db.VarChar(80)
  city      String?  @db.VarChar(80)

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@index([stableUid, createdAt])
  @@index([createdAt])
  @@map("login_events")
}

// Signing the website in with the POKYH app (services/qrLogin.ts): the website
// shows a code as a QR code, the signed-in app scans it and confirms. A row
// lives at most two minutes and is used once. Only hashes of the code and of
// the website's polling secret are kept; the sign-in the app hands over is
// sealed (AES-GCM) and goes with the row.
model QrLogin {
  id         String   @id @default(uuid()) @db.VarChar(36)
  codeHash   String   @unique @map("code_hash") @db.VarChar(64)
  pollHash   String   @unique @map("poll_hash") @db.VarChar(64)
  // "pending" → "approved" (by the app) → "done" (the website signed in)
  status     String   @default("pending") @db.VarChar(10)
  stableUid  String?  @map("stable_uid")
  credential String?  @db.Text
  // The website asking to be signed in, shown in the app before it confirms.
  client     String   @default("") @db.VarChar(8)
  platform   String   @default("") @db.VarChar(10)
  os         String   @default("") @db.VarChar(40)
  browser    String   @default("") @db.VarChar(40)
  ip         String?  @db.VarChar(45)
  country    String   @default("") @db.VarChar(2)
  region     String?  @db.VarChar(80)
  city       String?  @db.VarChar(80)
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("qr_logins")
}

model KnownSubject {
  key       String   @id @db.VarChar(200)
  longName  String   @map("long_name") @db.VarChar(200)
  shortName String   @map("short_name") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("known_subjects")
}

model SubjectImage {
  subject   String   @id @db.VarChar(200)
  data      Bytes    @db.LongBlob
  mimeType  String   @map("mime_type") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subject_images")
}

model ApiKey {
  id         String    @id @default(uuid())
  keyHash    String    @unique @map("key_hash")
  name       String
  // Free-text purpose/description set by the issuing admin (e.g. "mobile CI",
  // "partner integration"). Informational only, never parsed or enforced.
  purpose    String    @default("") @db.VarChar(255)
  // Free-text platform/OS hint supplied at creation (e.g. "iOS", "n8n").
  // Informational only.
  platform   String    @default("") @db.VarChar(80)
  // Comma-separated least-privilege capabilities. Existing rows retain full
  // compatibility through the `*` default; new keys should be scoped.
  scopes     String    @default("*") @db.VarChar(255)
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@map("api_keys")
}

model RequestLog {
  id        String   @id @default(uuid())
  method    String   @db.VarChar(10)
  path      String   @db.VarChar(500)
  status    Int
  duration  Int
  ip        String?  @db.VarChar(45)
  stableUid String?  @map("stable_uid") @db.VarChar(64)
  username  String?  @db.VarChar(100)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  error     String?  @db.VarChar(1000)
  // Correlates this row with the same request's Winston log lines and its
  // X-Request-Id response header (see src/middleware/requestId.ts).
  requestId String?  @map("request_id") @db.VarChar(64)
  // 'learn' | 'core' — which feature area this request belongs to, derived
  // from the path prefix in requestLogger.ts. Lets the admin Logs page filter
  // by feature without a second logging system.
  scope     String?  @db.VarChar(20)
  // Identifier for an administrator-issued integration key. The plaintext key
  // and its hash are never written to request logs.
  apiKeyId  String?  @map("api_key_id") @db.VarChar(64)
  // The signed-in account's school; for an admin panel request the school
  // the panel was looking at. Null for guests and system traffic.
  schoolId  String?  @map("school_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([stableUid])
  @@index([username])
  @@index([createdAt])
  @@index([requestId])
  @@index([apiKeyId])
  // The dashboard's and the Anfragen page's per-hour and per-status figures
  // read only these columns, in time order.
  @@index([createdAt, scope, status, duration])
  @@index([schoolId, createdAt])
  @@map("request_logs")
}

// Admin-editable scheduled-backup settings — a singleton row (id is always 1),
// same pattern as LearnConfig. A missing row, or a null field on it, falls
// back to the BACKUP_* environment defaults in src/config.ts. Individual
// backup files themselves are not tracked here — they're listed by scanning
// config.backupDir directly (see src/services/dbBackup.ts), so this table
// never needs to be kept in sync with the filesystem.
model BackupConfig {
  id            Int       @id @default(1)
  enabled       Boolean?
  // UTC hour (0-23) the daily backup targets.
  scheduleHour  Int?      @map("schedule_hour")
  retentionDays Int?      @map("retention_days")
  lastRunAt     DateTime? @map("last_run_at")
  // 'ok' or 'error' — the outcome of the most recent scheduled or manual run.
  lastRunStatus String?   @map("last_run_status") @db.VarChar(20)
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedBy     String?   @map("updated_by")

  @@map("backup_config")
}

// ─── School year archive ──────────────────────────────────────────────────────
// On August 1st each year school-only users, classes, todos and reminders are
// snapshotted here and then removed from the live tables so the new school year
// starts fresh. Admins and users with a LearnProfile keep their User records.

model SchoolYear {
  id        String   @id @default(uuid())
  label     String   @unique // "2025/2026"
  startYear Int      @unique @map("start_year") // 2025
  rolledAt  DateTime @map("rolled_at") // when rollover was performed
  note      String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  archivedUsers     ArchivedUser[]
  archivedClasses   ArchivedClass[]
  archivedTodos     ArchivedTodo[]
  archivedReminders ArchivedReminder[]
  archivedActivity  ArchivedActivity[]

  @@map("school_years")
}

model ArchivedUser {
  id                 String   @id @default(uuid())
  schoolYearId       String   @map("school_year_id")
  stableUid          String   @map("stable_uid")
  username           String
  role               String   @default("student") @db.VarChar(20)
  webuntisKlasseId   Int      @default(0) @map("webuntis_klasse_id")
  webuntisKlasseName String   @default("") @map("webuntis_klasse_name") @db.VarChar(255)
  classId            String?  @map("class_id")
  classCode          String?  @map("class_code")
  className          String?  @map("class_name")
  schoolId           String?  @map("school_id") @db.VarChar(36)
  createdAt          DateTime @map("created_at")

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@index([schoolYearId])
  @@index([schoolYearId, stableUid])
  @@map("archived_users")
}

model ArchivedClass {
  id               String   @id @default(uuid())
  schoolYearId     String   @map("school_year_id")
  originalId       String   @map("original_id")
  name             String
  code             String   @db.Char(6)
  webuntisKlasseId Int      @default(0) @map("webuntis_klasse_id")
  createdBy        String   @map("created_by")
  createdByName    String   @default("") @map("created_by_name")
  memberCount      Int      @default(0) @map("member_count")
  // MySQL does not support a portable literal default for TEXT. Every archive
  // write supplies an explicit JSON array, so the schema remains compatible
  // with `prisma db push` and avoids a silent database-specific fallback.
  membersJson      String   @map("members_json") @db.Text
  schoolId         String?  @map("school_id") @db.VarChar(36)
  createdAt        DateTime @map("created_at")

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@index([schoolYearId])
  @@map("archived_classes")
}

model ArchivedTodo {
  id           String    @id @default(uuid())
  schoolYearId String    @map("school_year_id")
  originalId   String    @map("original_id")
  stableUid    String    @map("stable_uid")
  username     String    @default("")
  title        String    @db.VarChar(500)
  details      String    @default("") @db.VarChar(5000)
  dueAt        DateTime? @map("due_at")
  done         Boolean   @default(false)
  doneAt       DateTime? @map("done_at")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @map("created_at")

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@index([schoolYearId])
  @@index([schoolYearId, stableUid])
  @@map("archived_todos")
}

// An account's year in figures, taken at the rollover from request_account_days
// and (with consent) usage_sessions — see services/accountActivitySummary.ts:
// totals, weekdays, hours, platforms and the active days, as JSON. Archived
// with the other data of the year and deleted with it — for every account,
// also those that stay after the rollover (admins, Learn; from 2026-10), as
// their rows of the year go just the same. A recap of the year reads it.
model ArchivedActivity {
  id           String   @id @default(uuid())
  schoolYearId String   @map("school_year_id")
  stableUid    String   @map("stable_uid")
  username     String   @default("")
  activeDays   Int      @default(0) @map("active_days")
  logins       Int      @default(0)
  activeSeconds Int     @default(0) @map("active_seconds")
  summaryJson  String   @map("summary_json") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@index([schoolYearId])
  @@index([schoolYearId, stableUid])
  @@map("archived_activity")
}

model ArchivedReminder {
  id                String    @id @default(uuid())
  schoolYearId      String    @map("school_year_id")
  originalId        String    @map("original_id")
  classId           String    @map("class_id")
  className         String    @default("") @map("class_name")
  title             String    @db.VarChar(500)
  body              String    @default("") @db.VarChar(5000)
  remindAt          DateTime  @map("remind_at")
  createdBy         String    @map("created_by")
  createdByName     String    @default("") @map("created_by_name")
  createdByUsername String    @default("") @map("created_by_username")
  archivedAt        DateTime? @map("archived_at")
  commentsJson      String    @map("comments_json") @db.Text
  createdAt         DateTime  @map("created_at")

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@index([schoolYearId])
  @@map("archived_reminders")
}

model FrontendActivityLog {
  id        String   @id @default(uuid())
  event     String   @db.VarChar(50)
  page      String?  @db.VarChar(500)
  detail    String?  @db.VarChar(500)
  stableUid String?  @map("stable_uid") @db.VarChar(64)
  username  String?  @db.VarChar(100)
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  // The signed-in account's school, also when the event is anonymous.
  schoolId  String?  @map("school_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([stableUid])
  @@index([username])
  @@index([createdAt])
  @@index([event])
  @@index([createdAt, event])
  @@index([schoolId, createdAt])
  @@map("frontend_activity_logs")
}

// ─── Usage analytics ─────────────────────────────────────────────────────────
// One row per visit to Pokyh, kept current by a foreground heartbeat from the
// web app and the iOS and Android apps (POST /usage/ping). It holds only what
// the admin Analytics page aggregates: the kind of device and client, how long
// Pokyh was in the foreground and how many screens were opened. No IP address,
// user agent, page path or content is stored.
//
// A visit names its account only if the account consented to the usage
// statistics (PrivacyConsent), and only for USAGE_ANALYTICS_RETENTION_DAYS;
// otherwise, and afterwards, the row is anonymous: a day-scoped visitor key
// (services/visitorKey.ts) lets the page count different people per day
// without knowing who. Anonymous rows feed the aggregate figures for as long
// as the page shows them.
model UsageSession {
  // Random per visit, chosen by the client and never reused.
  id            String   @id @db.VarChar(36)
  // The account, only with its consent (and never for guests).
  stableUid     String?  @map("stable_uid")
  // sha256(day salt + account), 16 hex characters: the same within the day,
  // unlinkable across days and to the account once the day's salt is gone.
  visitorKey    String?  @map("visitor_key") @db.VarChar(16)
  // "ios" | "android" | "desktop" | "other"
  device        String   @db.VarChar(10)
  // "app" (native) | "pwa" (website installed to the home screen) | "browser"
  client        String   @db.VarChar(10)
  // Native app version, e.g. "2.0.1"; empty for the website.
  appVersion    String   @default("") @map("app_version") @db.VarChar(32)
  // Local day and hour (ANALYTICS_TIMEZONE) the visit started in, so daily
  // and hourly figures group without timezone arithmetic in SQL.
  dayKey        String   @map("day_key") @db.VarChar(10)
  startHour     Int      @map("start_hour")
  activeSeconds Int      @default(0) @map("active_seconds")
  screens       Int      @default(0)
  startedAt     DateTime @default(now()) @map("started_at")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")
  // The signed-in account's school, kept also when the visit is anonymous —
  // a coarse group, so school administrators see their school's figures
  // only. Null for guests.
  schoolId      String?  @map("school_id") @db.VarChar(36)

  user User? @relation(fields: [stableUid], references: [stableUid], onDelete: SetNull)

  @@index([schoolId, dayKey])
  @@index([dayKey])
  @@index([stableUid, dayKey])
  @@index([lastSeenAt])
  @@map("usage_sessions")
}

// The random salt of one day's visitor keys (UsageSession.visitorKey). Deleted
// once the day is over, which makes that day's keys anonymous for good.
model UsageDaySalt {
  dayKey    String   @id @map("day_key") @db.VarChar(10)
  salt      String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("usage_day_salts")
}

// Anonymous per-class totals behind "Aktivste Klassen": time, visits and
// different people per class and day, added up as pings arrive. No account,
// key or single visit is kept; the page shows a class only from a few people
// up (routes/adminAnalytics.ts).
model UsageClassDay {
  dayKey  String @map("day_key") @db.VarChar(10)
  klasse  String @db.VarChar(64)
  seconds Int    @default(0)
  visits  Int    @default(0)
  people  Int    @default(0)

  @@id([dayKey, klasse])
  @@map("usage_class_days")
}

// Visitors behind "Besucher" and the visitor map on the admin Analytics page:
// one row per page view of the website, signed in or not
// (routes/activityLog.ts), and one per opening of a native app from an address
// on a day (`client` "app", routes/usage.ts). The address and the place
// derived from it are kept as long as the request logs
// (REQUEST_LOG_RETENTION_DAYS) and then removed; the row stays as an anonymous
// count of country, device, day, hour and page. It names the account only with
// that account's consent to the usage statistics, and loses it together with
// the address or on withdrawal.
model WebVisit {
  id         String   @id @default(uuid()) @db.VarChar(36)
  // "web": a page view of the website. "app": the iOS or Android app opened.
  client     String   @default("web") @db.VarChar(8)
  // An app opening's usage visit (usage_sessions.id), so that one visit is
  // stored once per address and day. Removed with the address.
  sessionId  String?  @map("session_id") @db.VarChar(36)
  // The app's version for an app opening; "" for the website.
  appVersion String   @default("") @map("app_version") @db.VarChar(32)
  // Null once expired, and from browsers that send Global Privacy Control.
  ip         String?  @db.VarChar(45)
  // ISO 3166-1 alpha-2 from the edge proxy (Cloudflare); "" when unknown.
  country    String   @default("") @db.VarChar(2)
  // Only when the edge sends visitor location headers; removed with the address.
  region     String?  @db.VarChar(80)
  city       String?  @db.VarChar(80)
  // sha256(day salt + address + user agent), 16 hex characters: counts
  // different visitors per day, unlinkable once the day's salt is deleted.
  visitorKey String   @map("visitor_key") @db.VarChar(16)
  // "ios" | "android" | "desktop" | "other"
  device     String   @db.VarChar(10)
  signedIn   Boolean  @default(false) @map("signed_in")
  // The signed-in account, only with its consent to the usage statistics.
  stableUid  String?  @map("stable_uid")
  // Any signed-in account as a keyed hash (16 hex characters, no name): counts
  // how many different accounts share an address. Removed with the address.
  accountKey String?  @map("account_key") @db.VarChar(16)
  // The website page without its language prefix ("/timetable"); "" for an app.
  page       String   @default("") @db.VarChar(200)
  dayKey     String   @map("day_key") @db.VarChar(10)
  hour       Int
  // The signed-in account's school, like usage_sessions.school_id.
  schoolId   String?  @map("school_id") @db.VarChar(36)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [stableUid], references: [stableUid], onDelete: SetNull)

  @@index([schoolId, dayKey])
  @@index([dayKey])
  @@index([ip])
  @@index([createdAt])
  @@index([stableUid])
  @@index([sessionId])
  @@map("web_visits")
}

// ─── Privacy notice and usage-statistics consent ─────────────────────────────
// Which version of the privacy notice an account last acknowledged at sign-in,
// and its choice on the usage statistics — an opt-in, never preset, revocable
// in the profile. Kept as proof (GDPR Art. 7(1)) and deleted with the account.
// See src/routes/privacy.ts.
model PrivacyConsent {
  stableUid      String    @id @map("stable_uid")
  // "" while only a consent choice was recorded and no notice acknowledged.
  noticeVersion  String    @map("notice_version") @db.VarChar(32)
  acknowledgedAt DateTime  @map("acknowledged_at")
  usageStats     Boolean   @default(false) @map("usage_stats")
  // When the current usage-statistics choice was made (given or withdrawn).
  usageStatsAt   DateTime? @map("usage_stats_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@index([usageStats])
  @@map("privacy_consents")
}

// ─── Schools and administration ──────────────────────────────────────────────
// One installation serves several schools. School-specific rows carry a
// school_id (users, classes, comments, ratings, popups, logs, visits); the
// admin panel's permissions are granted per school or globally
// (src/security/permissions.ts). See docs/multi-school.md.

model School {
  // Deterministic for the default school (src/services/schools.ts), so every
  // node of a cluster creates the same row.
  id             String   @id @db.VarChar(36)
  slug           String   @unique @db.VarChar(64)
  name           String   @db.VarChar(160)
  shortName      String   @default("") @map("short_name") @db.VarChar(60)
  // The WebUntis school name accounts of this school sign in with
  // ("lbs-brixen"); the trusted login names it.
  webuntisSchool String?  @unique @map("webuntis_school") @db.VarChar(100)
  webuntisBase   String   @default("") @map("webuntis_base") @db.VarChar(300)
  // An inactive school's accounts cannot sign in; its data stays.
  active         Boolean  @default(true)
  createdBy      String?  @map("created_by") @db.VarChar(191)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("schools")
}

// A menu (Mensaplan): summer and winter plan, rotation and dishes. A menu can
// be assigned to several schools; a school has at most one, and without one
// it shows no menu at all.
model MensaMenu {
  id        String   @id @db.VarChar(36)
  name      String   @db.VarChar(120)
  createdBy String?  @map("created_by") @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  schools MensaMenuSchool[]

  @@map("mensa_menus")
}

model MensaMenuSchool {
  menuId     String   @map("menu_id") @db.VarChar(36)
  // Unique: one menu per school.
  schoolId   String   @unique @map("school_id") @db.VarChar(36)
  assignedBy String?  @map("assigned_by") @db.VarChar(191)
  assignedAt DateTime @default(now()) @map("assigned_at")

  menu MensaMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([menuId, schoolId])
  @@map("mensa_menu_schools")
}

// What an administrator may do in one scope: "global" or a school id. Keyed
// by the admin login name, like the second factors, so it works for every
// kind of admin account. The id is derived from (username, scope), so two
// nodes granting at once produce the same row.
model AdminGrant {
  id          String   @id @db.VarChar(64)
  username    String   @db.VarChar(191)
  scope       String   @db.VarChar(36)
  // The preset the grant was made from — display only.
  preset      String   @default("custom") @db.VarChar(40)
  // JSON array of permission keys (src/security/permissions.ts).
  permissions String   @db.Text
  grantedBy   String?  @map("granted_by") @db.VarChar(191)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([username, scope])
  @@index([scope])
  @@map("admin_grants")
}

// Presets ("Vorlagen") for admin rights that admins made themselves, next to
// the built-in ones in security/permissions.ts. A grant keeps the preset key
// for display only; its own permission list is what counts, so changing or
// removing a preset never changes anyone's rights.
model AdminPreset {
  key         String   @id @db.VarChar(40)
  label       String   @db.VarChar(60)
  description String   @default("") @db.VarChar(300)
  // "school" or "global".
  scope       String   @db.VarChar(10)
  // JSON array of permission keys.
  permissions String   @db.Text
  createdBy   String   @map("created_by") @db.VarChar(191)
  updatedBy   String   @map("updated_by") @db.VarChar(191)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("admin_presets")
}

// The admin audit trail: who changed what, in which school, when. Holds no
// passwords, tokens or request bodies — only what was done to which record.
// Kept AUDIT_RETENTION_DAYS (at least 180: the Garante's measures on system
// administrators, 27 Nov 2008, ask for six months of access records).
model AdminAuditEvent {
  id         String   @id @default(uuid()) @db.VarChar(36)
  actor      String   @db.VarChar(191)
  action     String   @db.VarChar(60)
  targetType String   @default("") @map("target_type") @db.VarChar(40)
  targetId   String   @default("") @map("target_id") @db.VarChar(191)
  schoolId   String?  @map("school_id") @db.VarChar(36)
  // Small JSON object with what changed (never secrets). TEXT takes no
  // default in MySQL; every write supplies one (services/audit.ts).
  detail     String   @db.Text
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actor, createdAt])
  @@index([schoolId, createdAt])
  @@map("admin_audit_events")
}

// Errors the web app and the native apps report (POST /client-errors). Never
// trusted: validated, truncated and stripped of addresses, tokens and query
// strings before storing. No account, no IP address, no full user agent —
// only what is needed to find and fix the error. Node-local like the request
// logs, removed after CLIENT_ERROR_RETENTION_DAYS.
model ClientErrorLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  // "web" | "android" | "ios" | "admin"
  source      String   @db.VarChar(10)
  // "error" | "warning"
  level       String   @default("error") @db.VarChar(10)
  name        String   @default("") @db.VarChar(100)
  message     String   @db.VarChar(500)
  stack       String?  @db.Text
  page        String   @default("") @db.VarChar(200)
  release     String   @default("") @db.VarChar(40)
  // Coarse browser or app family, e.g. "Safari 18" — never the full string.
  browser     String   @default("") @db.VarChar(40)
  // Groups the same error: a hash of name, message and first stack frame.
  fingerprint String   @db.Char(16)
  schoolId    String?  @map("school_id") @db.VarChar(36)
  // The X-Request-Id of a failed API call the error is about, if any.
  requestId   String?  @map("request_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([fingerprint, createdAt])
  @@index([schoolId, createdAt])
  @@map("client_error_logs")
}

// Which accounts used Pokyh on which local day, and on which kind of device
// and client — the request logs' evidence for the Analytics page, kept small:
// one row per account, day and device kind instead of every request. Written
// by the request logger (middleware/requestLogger.ts) on an account's first
// request of a day, and every few minutes after; removed with the request
// logs (REQUEST_LOG_RETENTION_DAYS). Node-local like request_logs.
model RequestAccountDay {
  dayKey    String   @map("day_key") @db.VarChar(10)
  stableUid String   @map("stable_uid") @db.VarChar(64)
  // As usage_sessions: "ios" | "android" | "desktop" | "other" and
  // "app" | "pwa" | "browser" (classifyUserAgent).
  device    String   @db.VarChar(10)
  client    String   @db.VarChar(10)
  schoolId  String?  @map("school_id") @db.VarChar(36)
  lastAt    DateTime @map("last_at")
  // Successful sign-ins on this day and device kind (POST /auth/login|register,
  // not the website's automatic renewals): the account's own sign-in count
  // outlives the 30 days of the request logs for the school year.
  signIns   Int      @default(0) @map("sign_ins")

  @@id([dayKey, stableUid, device, client])
  @@index([schoolId, dayKey])
  @@index([stableUid, dayKey])
  @@map("request_account_days")
}

// One-time data migrations already done (src/services/multiSchool.ts).
model AppMigration {
  id        String   @id @db.VarChar(80)
  detail    String   @default("") @db.VarChar(500)
  appliedAt DateTime @default(now()) @map("applied_at")

  @@map("app_migrations")
}

// "Aktivste Klassen" per school: like usage_class_days, but class names are
// only unique within a school.
model UsageSchoolClassDay {
  dayKey   String @map("day_key") @db.VarChar(10)
  schoolId String @map("school_id") @db.VarChar(36)
  klasse   String @db.VarChar(64)
  seconds  Int    @default(0)
  visits   Int    @default(0)
  people   Int    @default(0)

  @@id([dayKey, schoolId, klasse])
  @@index([schoolId, dayKey])
  @@map("usage_school_class_days")
}

// ─── Pokyh Learn ─────────────────────────────────────────────────────────────
// Learn content lives alongside the existing POKYH account rather than creating
// a second identity or token system.  Fields ending in `Json` intentionally use
// text so import/export payloads remain portable and the public API can validate
// their shape before persisting them.

model LearnProfile {
  stableUid                   String    @id @map("stable_uid")
  dailyGoalMinutes            Int       @default(15) @map("daily_goal_minutes")
  timezone                    String    @default("") @db.VarChar(80)
  locale                      String    @default("de") @db.VarChar(5)
  theme                       String    @default("system") @db.VarChar(10)
  privacyNoticeVersion        String    @default("") @map("privacy_notice_version") @db.VarChar(80)
  privacyNoticeAcknowledgedAt DateTime? @map("privacy_notice_acknowledged_at")
  dailyStreak                 Int       @default(0) @map("daily_streak")
  lastActiveAt                DateTime? @map("last_active_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@index([lastActiveAt])
  @@map("learn_profiles")
}

model LearnCourse {
  id            String   @id @default(uuid())
  slug          String   @unique @db.VarChar(191)
  title         String   @db.VarChar(160)
  summary       String   @default("") @db.VarChar(2000)
  subject       String   @default("") @db.VarChar(120)
  language      String   @default("") @db.VarChar(80)
  level         String   @default("") @db.VarChar(50)
  // PRIVATE, TEAM, or PUBLIC.  PUBLIC courses are only shown in the catalog
  // once their status is PUBLISHED.
  visibility    String   @default("PRIVATE") @db.VarChar(20)
  // DRAFT, PUBLISHED, or ARCHIVED.
  status        String   @default("DRAFT") @db.VarChar(20)
  coverImageUrl String   @default("") @map("cover_image_url") @db.VarChar(1000)
  createdBy     String   @map("created_by")
  teamId        String?  @map("team_id")
  // When true, a platform administrator has deliberately locked this course's
  // ownership — reassigning createdBy is blocked until an admin unlocks it
  // first. A safety guard against accidental reassignment, not a permission
  // change: an admin can always toggle it, just not reassign in the same step.
  ownerLocked   Boolean  @default(false) @map("owner_locked")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  creator            User                     @relation("LearnCourseCreator", fields: [createdBy], references: [stableUid], onDelete: Cascade)
  team               LearnTeam?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sections           LearnCourseSection[]
  accessGrants       LearnCourseAccess[]
  enrollments        LearnEnrollment[]
  vocabulary         LearnVocabularyEntry[]
  quizAttempts       LearnQuizAttempt[]
  sectionCompletions LearnSectionCompletion[]
  activityDays       LearnActivityDaily[]

  @@index([createdBy])
  @@index([teamId])
  @@index([visibility, status, updatedAt])
  @@map("learn_courses")
}

model LearnCourseSection {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String   @db.VarChar(200)
  summary     String   @default("") @db.VarChar(2000)
  // LESSON, VOCABULARY, GRAMMAR, QUIZ, or a future server-defined type.
  type        String   @default("LESSON") @db.VarChar(40)
  sortOrder   Int      @default(0) @map("sort_order")
  contentJson String   @map("content_json") @db.LongText
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course      LearnCourse              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  vocabulary  LearnVocabularyEntry[]
  completions LearnSectionCompletion[]

  @@unique([courseId, sortOrder])
  @@index([courseId])
  @@map("learn_course_sections")
}

// Explicit per-course grants make it possible for a POKYH administrator to
// allow trusted learners to contribute content without making them global admins.
model LearnCourseAccess {
  courseId   String   @map("course_id")
  stableUid  String   @map("stable_uid")
  // VIEW, EDIT, or MANAGE.
  permission String   @default("VIEW") @db.VarChar(20)
  grantedBy  String?  @map("granted_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  course LearnCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@id([courseId, stableUid])
  @@index([stableUid])
  @@map("learn_course_access")
}

model LearnEnrollment {
  courseId          String    @map("course_id")
  stableUid         String    @map("stable_uid")
  // ACTIVE, PAUSED, or COMPLETED.
  status            String    @default("ACTIVE") @db.VarChar(20)
  progressPercent   Float     @default(0) @map("progress_percent")
  completedSections Int       @default(0) @map("completed_sections")
  lastOpenedAt      DateTime? @map("last_opened_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  course LearnCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@id([courseId, stableUid])
  @@index([stableUid, lastOpenedAt])
  @@map("learn_enrollments")
}

// A completion is an explicit learner action on one real server-side section.
// Aggregate enrollment progress is derived from these records instead of
// accepting an arbitrary percentage from the browser.
model LearnSectionCompletion {
  stableUid   String   @map("stable_uid")
  courseId    String   @map("course_id")
  sectionId   String   @map("section_id")
  completedAt DateTime @default(now()) @map("completed_at")

  user    User               @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)
  course  LearnCourse        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section LearnCourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([stableUid, sectionId])
  @@index([courseId, stableUid])
  @@map("learn_section_completions")
}

model LearnVocabularyEntry {
  id                 String   @id @default(uuid())
  courseId           String   @map("course_id")
  sectionId          String?  @map("section_id")
  sourceLanguage     String   @map("source_language") @db.VarChar(20)
  targetLanguage     String   @map("target_language") @db.VarChar(20)
  sourceText         String   @map("source_text") @db.VarChar(500)
  targetText         String   @map("target_text") @db.VarChar(500)
  normalizedSource   String   @map("normalized_source") @db.VarChar(500)
  normalizedTarget   String   @map("normalized_target") @db.VarChar(500)
  article            String   @default("") @db.VarChar(40)
  partOfSpeech       String   @default("") @map("part_of_speech") @db.VarChar(80)
  notes              String   @default("") @db.VarChar(2000)
  tagsJson           String   @map("tags_json") @db.Text
  // UNVERIFIED, VERIFIED, or FLAGGED.  A future dictionary integration can
  // populate verificationSource without changing the entry contract.
  verificationStatus String   @default("UNVERIFIED") @map("verification_status") @db.VarChar(20)
  verificationSource String   @default("") @map("verification_source") @db.VarChar(120)
  createdBy          String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  course            LearnCourse             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section           LearnCourseSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  creator           User                    @relation("LearnVocabularyCreator", fields: [createdBy], references: [stableUid], onDelete: Cascade)
  reviewStates      LearnVocabularyReview[]
  aiTrainingPrompts LearnAiTrainingPrompt[]

  @@index([courseId, sectionId])
  @@index([createdBy])
  @@map("learn_vocabulary_entries")
}

// Per-user spaced-review state.  It is updated atomically with a quiz attempt,
// so a wrong answer remains recoverable for a dedicated review quiz.
model LearnVocabularyReview {
  id             String    @id @default(uuid())
  stableUid      String    @map("stable_uid")
  entryId        String    @map("entry_id")
  intervalDays   Int       @default(0) @map("interval_days")
  easeFactor     Float     @default(2.5) @map("ease_factor")
  dueAt          DateTime  @default(now()) @map("due_at")
  lastReviewedAt DateTime? @map("last_reviewed_at")
  correctCount   Int       @default(0) @map("correct_count")
  incorrectCount Int       @default(0) @map("incorrect_count")
  lastWasCorrect Boolean   @default(false) @map("last_was_correct")
  // The next prompt reverses this direction. The server stores it rather
  // than letting a browser choose which translation should be graded.
  lastDirection  String?   @map("last_direction") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user  User                 @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)
  entry LearnVocabularyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([stableUid, entryId])
  @@index([stableUid, dueAt])
  @@map("learn_vocabulary_reviews")
}

// A durable, idempotent record of server-graded answers.  `answersJson` stores
// the submitted answer and the server result; expected answers never come from
// the client and are not exposed by the review queue endpoint.
model LearnQuizAttempt {
  id             String   @id @default(uuid())
  stableUid      String   @map("stable_uid")
  courseId       String   @map("course_id")
  mode           String   @default("PRACTICE") @db.VarChar(40)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(191)
  answersJson    String   @map("answers_json") @db.LongText
  totalQuestions Int      @map("total_questions")
  correctAnswers Int      @map("correct_answers")
  score          Float    @default(0)
  // Client-measured wall-clock time actively spent on this attempt (session
  // start to submit), sanity-capped server-side. Optional and defaults to 0
  // for older clients — never inferred or estimated, only ever real elapsed
  // time the client actually observed, so profile/streak minutes stay honest.
  durationMs     Int      @default(0) @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  user   User        @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)
  course LearnCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([stableUid, idempotencyKey])
  @@index([stableUid, createdAt])
  @@index([courseId, createdAt])
  @@map("learn_quiz_attempts")
}

// One compact activity row per learner, course and local calendar day. It is
// updated in the same transaction as a server-graded quiz attempt, so the
// analytics view is durable, idempotent and never needs raw answer text.
model LearnActivityDaily {
  stableUid      String   @map("stable_uid")
  courseId       String   @map("course_id")
  dayKey         String   @map("day_key") @db.VarChar(10)
  attemptCount   Int      @default(0) @map("attempt_count")
  answerCount    Int      @default(0) @map("answer_count")
  correctCount   Int      @default(0) @map("correct_count")
  durationMs     Int      @default(0) @map("duration_ms")
  lastActivityAt DateTime @map("last_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user   User        @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)
  course LearnCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([stableUid, courseId, dayKey])
  @@index([stableUid, dayKey])
  @@index([courseId, dayKey])
  @@map("learn_activity_daily")
}

model LearnTeam {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(120)
  description String   @default("") @db.VarChar(1000)
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator       User                    @relation("LearnTeamCreator", fields: [createdBy], references: [stableUid], onDelete: Cascade)
  members       LearnTeamMember[]
  courses       LearnCourse[]
  aiAccessGrant LearnAiTeamAccessGrant?

  @@index([createdBy])
  @@map("learn_teams")
}

model LearnTeamMember {
  teamId    String   @map("team_id")
  stableUid String   @map("stable_uid")
  // OWNER, MANAGER, or MEMBER.
  role      String   @default("MEMBER") @db.VarChar(20)
  joinedAt  DateTime @default(now()) @map("joined_at")

  team LearnTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@id([teamId, stableUid])
  @@index([stableUid])
  @@map("learn_team_members")
}

// Admin-editable Learn configuration — a singleton row (id is always 1). Read
// live via src/services/learnConfig.ts with a short in-memory cache; a missing
// row, or a null field on it, falls back to the LEARN_* environment defaults
// in src/config.ts, so the app works correctly before any admin ever saves
// this. LEARN_ALLOWED_ORIGINS is deliberately NOT included: it is a security-
// boundary value and stays environment-only, never admin-editable at runtime.
model LearnConfig {
  id                                  Int      @id @default(1)
  legalGateEnabled                    Boolean? @map("legal_gate_enabled")
  // Set via the admin UI but never read back in plaintext by the API —
  // matches docs/legal-readiness.md's requirement to report the legal gate
  // as ready without exposing the approval reference itself.
  webUntisAuthorizationReference      String?  @map("webuntis_authorization_reference") @db.VarChar(255)
  privacyNoticeUrl                    String?  @map("privacy_notice_url") @db.VarChar(500)
  privacyNoticeVersion                String?  @map("privacy_notice_version") @db.VarChar(80)
  dictionaryEnabled                   Boolean? @map("dictionary_enabled")
  dictionaryProvider                  String?  @map("dictionary_provider") @db.VarChar(40)
  dictionaryBaseUrl                   String?  @map("dictionary_base_url") @db.VarChar(500)
  dictionaryContactEmail              String?  @map("dictionary_contact_email") @db.VarChar(255)
  dictionaryAllowedPairs              String?  @map("dictionary_allowed_pairs") @db.VarChar(500)
  dictionaryTimeoutMs                 Int?     @map("dictionary_timeout_ms")
  dictionaryCacheTtlMs                Int?     @map("dictionary_cache_ttl_ms")
  dictionaryMaxCacheEntries           Int?     @map("dictionary_max_cache_entries")
  // Free Dictionary API is configured separately from optional translation
  // suggestions. The backend supports its documented English endpoint only.
  dictionaryValidationEnabled         Boolean? @map("dictionary_validation_enabled")
  dictionaryValidationProvider        String?  @map("dictionary_validation_provider") @db.VarChar(40)
  dictionaryValidationBaseUrl         String?  @map("dictionary_validation_base_url") @db.VarChar(500)
  dictionaryValidationTimeoutMs       Int?     @map("dictionary_validation_timeout_ms")
  dictionaryValidationCacheTtlMs      Int?     @map("dictionary_validation_cache_ttl_ms")
  dictionaryValidationMaxCacheEntries Int?     @map("dictionary_validation_max_cache_entries")
  // Adaptive-review policy and pseudonymous analytics retention. The browser
  // never supplies scheduling decisions; these values are applied server-side.
  reviewInitialIntervalDays           Int?     @map("review_initial_interval_days")
  reviewMaxIntervalDays               Int?     @map("review_max_interval_days")
  reviewMinimumEase                   Float?   @map("review_minimum_ease")
  reviewMaximumEase                   Float?   @map("review_maximum_ease")
  reviewCorrectEaseStep               Float?   @map("review_correct_ease_step")
  reviewIncorrectEasePenalty          Float?   @map("review_incorrect_ease_penalty")
  reviewWrongDelayMinutes             Int?     @map("review_wrong_delay_minutes")
  analyticsRetentionDays              Int?     @map("analytics_retention_days")
  importMaxCourses                    Int?     @map("import_max_courses")
  importMaxSectionsPerCourse          Int?     @map("import_max_sections_per_course")
  importMaxVocabularyPerCourse        Int?     @map("import_max_vocabulary_per_course")
  updatedAt                           DateTime @updatedAt @map("updated_at")
  updatedBy                           String?  @map("updated_by")

  @@map("learn_config")
}

// ─── Pokyh Learn AI trainer ─────────────────────────────────────────────────
// AI exists only inside vocabulary practice. A prompt stores the AI-generated
// sentence and its expected translation server-side for a short time; clients
// receive only the source sentence, so they cannot supply their own answer key
// or make a grading decision.
model LearnAiTrainingPrompt {
  id                String    @id @default(uuid())
  stableUid         String    @map("stable_uid")
  entryId           String    @map("entry_id")
  direction         String    @db.VarChar(20)
  promptText        String    @map("prompt_text") @db.VarChar(1000)
  // SHA-256 of normalized promptText. Repeated calls for the same learner and
  // word must not recycle an earlier AI sentence.
  promptFingerprint String?   @map("prompt_fingerprint") @db.Char(64)
  expectedText      String    @map("expected_text") @db.VarChar(1000)
  modelName         String    @map("model_name") @db.VarChar(120)
  createdAt         DateTime  @default(now()) @map("created_at")
  expiresAt         DateTime  @map("expires_at")
  completedAt       DateTime? @map("completed_at")
  resultCorrect     Boolean?  @map("result_correct")

  user  User                 @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)
  entry LearnVocabularyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([stableUid, entryId, promptFingerprint])
  @@index([stableUid, expiresAt])
  @@index([entryId])
  @@map("learn_ai_training_prompts")
}

// Pilot allowlist — the only source of AI-trainer access. A learner with no
// row here, or whose grant has revokedAt set, gets 403 on every /learn/ai/*
// route regardless of any other configuration.
model LearnAiAccessGrant {
  stableUid String    @id @map("stable_uid")
  grantedBy String    @map("granted_by")
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedBy String?   @map("revoked_by")
  revokedAt DateTime? @map("revoked_at")
  note      String    @default("") @db.VarChar(500)

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@index([revokedAt])
  @@map("learn_ai_access_grants")
}

// A whole-team grant: every current and future member of the team has
// trainer access without an individual LearnAiAccessGrant row per person —
// canonical Pokyh administrator action only, same spirit as team creation
// itself. hasActiveAiGrant() (learnAiAccess.ts) checks both this and the
// per-user grant above; either is sufficient.
model LearnAiTeamAccessGrant {
  teamId    String    @id @map("team_id")
  grantedBy String    @map("granted_by")
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedBy String?   @map("revoked_by")
  revokedAt DateTime? @map("revoked_at")
  note      String    @default("") @db.VarChar(500)

  team LearnTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([revokedAt])
  @@map("learn_ai_team_access_grants")
}

// The authoritative per-user quota ledger (src/services/learnAiRateLimit.ts).
// Redis may accelerate the check but this table enforces it, so the limit
// still holds correctly if Redis is absent or fails.
model LearnAiUsageCounter {
  stableUid    String   @map("stable_uid")
  windowStart  DateTime @map("window_start")
  messageCount Int      @default(0) @map("message_count")
  tokenCount   Int      @default(0) @map("token_count")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@id([stableUid, windowStart])
  @@index([windowStart])
  @@map("learn_ai_usage_counters")
}

// Admin-editable AI operational policy. A missing row, or a null field on it,
// falls back to the LEARN_AI_* environment defaults in src/config.ts.
model LearnAiConfig {
  id                               Int      @id @default(1)
  // Global kill-switch, independent of per-user pilot grants — both must
  // allow a request through.
  enabled                          Boolean? @map("enabled")
  modelName                        String?  @map("model_name") @db.VarChar(120)
  // num_ctx sent to Ollama. Deliberately kept small by default: RAM for a
  // CPU-quantized model grows sharply with context length (see docs).
  contextTokens                    Int?     @map("context_tokens")
  numPredictFast                   Int?     @map("num_predict_fast")
  rateLimitMessagesPerHour         Int?     @map("rate_limit_messages_per_hour")
  // The in-app trainer caps outgoing model work before Ollama. This default
  // is intentionally configurable so a larger verified host can serve a
  // whole class without exposing an unbounded inference endpoint.
  maxConcurrentTrainingGenerations Int?     @map("max_concurrent_training_generations")
  ollamaBaseUrl                    String?  @map("ollama_base_url") @db.VarChar(300)
  ollamaTimeoutMs                  Int?     @map("ollama_timeout_ms")
  updatedAt                        DateTime @updatedAt @map("updated_at")
  updatedBy                        String?  @map("updated_by")

  @@map("learn_ai_config")
}

// ─── Announcement popups ──────────────────────────────────────────────────────
// Admin-authored popups shown inside the web app and/or the Android app.
// `content` is the Markdown/HTML source the admin typed; `contentHtml` is the
// sanitised render delivered to clients (see src/services/popupRender.ts), so
// clients never parse or trust raw admin input themselves.
//
// Scheduling: a popup is live while `enabled` and now ∈ [startsAt, endsAt)
// (either bound may be null = open). The window is split into `showCount`
// equal slots and a client shows the popup at most once per slot — e.g.
// 7 shows over 7 days = at most once a day, and nothing after the window ends
// regardless of how many slots were missed. "once" is simply showCount = 1.
// "Seen" state is tracked per device by the clients, keyed by id + revision;
// bumping `revision` makes every client treat the popup as unseen again.
model Popup {
  id          String    @id @default(uuid())
  title       String    @db.VarChar(200)
  content     String    @db.MediumText
  contentHtml String    @map("content_html") @db.MediumText
  // "all" | "web" | "android"
  platform    String    @default("all") @db.VarChar(10)
  // "all" | "users" | "guests" — guests only exist on the website; the
  // Android app is always signed in and requests the "users" audience.
  audience    String    @default("all") @db.VarChar(10)
  // "once" | "recurring"
  mode        String    @default("once") @db.VarChar(12)
  showCount   Int       @default(1) @map("show_count")
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  enabled     Boolean   @default(true)
  revision    Int       @default(1)
  createdBy   String?   @map("created_by") @db.VarChar(100)
  // Null: every school (global administrators only). Otherwise only the
  // accounts of this school see it.
  schoolId    String?   @map("school_id") @db.VarChar(36)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Meant for chosen people only (both empty: everybody the platform and
  // audience allow) — see src/routes/popups.ts.
  targetUsers   PopupTargetUser[]
  targetClasses PopupTargetClass[]

  @@index([enabled, platform])
  @@index([schoolId])
  @@map("popups")
}

// A user a popup is meant for. Goes with the popup and with the account.
model PopupTargetUser {
  popupId   String @map("popup_id")
  stableUid String @map("stable_uid")

  popup Popup @relation(fields: [popupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@id([popupId, stableUid])
  @@index([stableUid])
  @@map("popup_target_users")
}

// A class (WebUntis class id, as users sign in with) a popup is meant for.
// The name is kept as chosen, for the admin panel.
model PopupTargetClass {
  popupId    String @map("popup_id")
  klasseId   Int    @map("klasse_id")
  klasseName String @default("") @map("klasse_name") @db.VarChar(100)

  popup Popup @relation(fields: [popupId], references: [id], onDelete: Cascade)

  @@id([popupId, klasseId])
  @@index([klasseId])
  @@map("popup_target_classes")
}

// ─── Recaps ("Dein Schuljahr", a year in review) ─────────────────────────────
// An admin-made review of a period (periodFrom … periodTo, local days, both
// included) that students open as a story in the app, between startsAt and
// endsAt (either may be null = open). Its WebUntis figures (lessons,
// absences, grades …) are worked out on the student's device with their own
// WebUntis session and never reach this server; the POKYH figures come from
// what is kept anyway (services/recaps.ts). See src/routes/recaps.ts.
model Recap {
  id         String    @id @default(uuid())
  title      String    @db.VarChar(120)
  periodFrom String    @map("period_from") @db.VarChar(10)
  periodTo   String    @map("period_to") @db.VarChar(10)
  startsAt   DateTime? @map("starts_at")
  endsAt     DateTime? @map("ends_at")
  // The parts it shows, comma-separated ("school,absences,grades,pokyh");
  // empty: every part.
  sections   String    @default("") @db.VarChar(200)
  enabled    Boolean   @default(true)
  // Null: made in the global view, it may reach every school. Otherwise
  // only the accounts of this school.
  schoolId   String?   @map("school_id") @db.VarChar(36)
  createdBy  String?   @map("created_by") @db.VarChar(100)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Meant for chosen schools, classes and students only (all empty: every
  // student the recap's school allows).
  targetSchools RecapTargetSchool[]
  targetClasses RecapTargetClass[]
  targetUsers   RecapTargetUser[]
  views         RecapView[]

  @@index([enabled])
  @@index([schoolId])
  @@map("recaps")
}

model RecapTargetSchool {
  recapId  String @map("recap_id")
  schoolId String @map("school_id") @db.VarChar(36)

  recap Recap @relation(fields: [recapId], references: [id], onDelete: Cascade)

  @@id([recapId, schoolId])
  @@index([schoolId])
  @@map("recap_target_schools")
}

// A WebUntis class (its id is unique within a school only). The name is kept
// as chosen, for the admin panel.
model RecapTargetClass {
  recapId    String @map("recap_id")
  schoolId   String @map("school_id") @db.VarChar(36)
  klasseId   Int    @map("klasse_id")
  klasseName String @default("") @map("klasse_name") @db.VarChar(100)

  recap Recap @relation(fields: [recapId], references: [id], onDelete: Cascade)

  @@id([recapId, schoolId, klasseId])
  @@index([schoolId, klasseId])
  @@map("recap_target_classes")
}

model RecapTargetUser {
  recapId   String @map("recap_id")
  stableUid String @map("stable_uid")

  recap Recap @relation(fields: [recapId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@id([recapId, stableUid])
  @@index([stableUid])
  @@map("recap_target_users")
}

// That an account was shown a recap and watched it to the end — nothing it
// showed. A recap opens by itself after signing in only while there is no
// row: shown once on any device, every device has it as the banner in the
// top bar instead. The admin panel counts the rows. Goes with the recap
// (deleted again by "Allen wieder als neu zeigen") and with the account.
model RecapView {
  recapId    String    @map("recap_id")
  stableUid  String    @map("stable_uid")
  openedAt   DateTime  @default(now()) @map("opened_at")
  finishedAt DateTime? @map("finished_at")

  recap Recap @relation(fields: [recapId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@id([recapId, stableUid])
  @@index([stableUid])
  @@map("recap_views")
}

// ─── Session revocation ──────────────────────────────────────────────────────
// One row per account whose access tokens were force-revoked (admin session
// revoke, password reset, account deletion). Auth middleware rejects any JWT
// issued before `revokedAt`. Persisted so a restart does not silently re-admit
// a revoked token, and replicated so every node in a cluster enforces it.
model TokenRevocation {
  stableUid String   @id @map("stable_uid") @db.VarChar(191)
  revokedAt DateTime @map("revoked_at")

  @@map("token_revocations")
}

// ─── Cluster (multi-node replication) ────────────────────────────────────────
// Every table below is node-local operational state and is never replicated.
// See src/cluster/ for the protocol; README.md documents the operator workflow.

// Identity of this node — a singleton row (id is always 1).
model ClusterNode {
  id           Int      @id @default(1)
  nodeId       String   @unique @map("node_id") @db.VarChar(36)
  name         String   @default("") @db.VarChar(120)
  // The address other nodes reach this one at, as last entered when inviting
  // or joining (CLUSTER_ADVERTISE_URL takes precedence when set).
  advertiseUrl String   @default("") @map("advertise_url") @db.VarChar(255)
  // This node's certificate for the mutually authenticated channel and its
  // private key, stored only in wrapped form (mtls.ts). Created on first use.
  tlsCert      String?  @map("tls_cert") @db.Text
  tlsKeyEnc    String?  @map("tls_key_enc") @db.Text
  // The ways to reach this node set in the admin panel (JSON; see
  // src/cluster/reach.ts), in addition to CLUSTER_MTLS_URL/_ENDPOINTS.
  reachConfig  String?  @map("reach_config") @db.Text
  // What the cluster exchanges (src/cluster/scopeRules.ts), as this node last
  // set or took over: Pokyh Learn yes/no, when, on which node, by whom.
  // Unset: CLUSTER_REPLICATE_LEARN.
  scopeLearn   Boolean? @map("scope_learn")
  scopeVersion BigInt   @default(0) @map("scope_version")
  scopeBy      String?  @map("scope_by") @db.VarChar(36)
  scopeActor   String?  @map("scope_actor") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("cluster_node")
}

// A peer node. It comes into being through an invite code (this node invited
// it: role HOST, or it was introduced to this node by a common peer) or by
// joining with a code (role JOIN — this node contacts the other). `nodeId` is
// confirmed during pairing. Key material is stored only in wrapped
// (AES-256-GCM) form and never returned by any API.
model ClusterPeer {
  id               String    @id @default(uuid()) @db.VarChar(36)
  nodeId           String?   @unique @map("node_id") @db.VarChar(36)
  name             String    @default("") @db.VarChar(120)
  // Empty for an invite nobody has used yet: the joining node tells us.
  address          String    @db.VarChar(255)
  // PENDING, ACTIVE, DISABLED, EXPIRED, LOCKED, or REMOVED.
  status           String    @default("PENDING") @db.VarChar(20)
  // HOST waits to be contacted, JOIN contacts the other node.
  role             String    @default("JOIN") @db.VarChar(8)
  // Node id of the common peer that introduced the two nodes, if any.
  introducedBy     String?   @map("introduced_by") @db.VarChar(36)
  linkKeyEnc       String?   @map("link_key_enc") @db.VarChar(255)
  // Present only while a pairing window is open; wiped on success or expiry.
  pairingSecretEnc String?   @map("pairing_secret_enc") @db.Text
  pairingStateEnc  String?   @map("pairing_state_enc") @db.Text
  pairingExpiresAt DateTime? @map("pairing_expires_at")
  pairingFailures  Int       @default(0) @map("pairing_failures")
  // Set when this node must ask the peer to resend its complete state.
  resyncRequested  Boolean   @default(false) @map("resync_requested")
  // Progress of a complete transfer to this peer (first pairing, resync): the
  // version registry is walked in key order from this position. Changes made
  // meanwhile reach the peer through the change feed.
  scanActive       Boolean   @default(false) @map("scan_active")
  scanTable        String?   @map("scan_table") @db.VarChar(64)
  scanHash         String?   @map("scan_hash") @db.Char(64)
  // Read position in this node's change feed: every change up to here has
  // reached the peer. Written once per delivered package, not per row.
  sentSeq          BigInt    @default(0) @map("sent_seq") @db.UnsignedBigInt
  lastSyncedAt     DateTime? @map("last_synced_at")
  lastVerifiedAt   DateTime? @map("last_verified_at")
  // The peer's pinned certificate and its pin (SHA-256 of the public key),
  // and where its mutually authenticated channel is reached. Learned only
  // over authenticated paths: pairing, an introduction, the install token or
  // the encrypted link itself.
  certPem          String?   @map("cert_pem") @db.Text
  certPin          String?   @map("cert_pin") @db.VarChar(64)
  channelUrl       String?   @map("channel_url") @db.VarChar(255)
  // Every way the peer announced to reach its channel, in its order of
  // preference (JSON array of endpoints; channelUrl is the first).
  channelEndpoints String?   @map("channel_endpoints") @db.Text
  // The ways through the peer's own web proxy it offers (JSON array of
  // URLs; unpinned, used only when the channel fails — src/cluster/reach.ts).
  pathWays         String?   @map("path_ways") @db.Text
  // Set once both directions have worked over the mutually authenticated
  // channel: from then on the peer is only accepted there (no downgrade).
  tlsLocked        Boolean   @default(false) @map("tls_locked")
  // A pairing window that may only be completed over that channel.
  tlsRequired      Boolean   @default(false) @map("tls_required")
  createdBy        String?   @map("created_by") @db.VarChar(100)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("cluster_peers")
}

// A Pokyh relay the nodes of this cluster can be reached through
// (src/cluster/relayClient.ts, deploy/relay). Unlike the cluster_* tables it
// is replicated, so a relay added on one node is used by every node — there
// is no leader to configure. The relay key holds a registration secret and is
// stored only encrypted, under a key every node derives from the shared
// JWT_SECRET.
model Relay {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @default("") @db.VarChar(60)
  // The pin of the relay's own certificate identifies the relay.
  relayPin  String   @unique @map("relay_pin") @db.VarChar(64)
  keyEnc    String   @map("key_enc") @db.Text
  enabled   Boolean  @default(true)
  // Reach the nodes through the relay's own port(s), and/or on 443 under the
  // relay's domain (forwarded by the administrator's proxy).
  usePorts  Boolean  @default(true) @map("use_ports")
  useSni    Boolean  @default(true) @map("use_sni")
  createdBy String?  @map("created_by") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("relays")
}

// How the cluster updates itself (src/cluster/updates.ts): which git
// repository and branch, whether new versions roll out on their own, and
// whether their checks must have passed. One row ("cluster"); replicated like
// `relays`, so a change on any node applies to all of them. Without the row,
// the CLUSTER_UPDATE_* settings apply.
model UpdateSettings {
  id             String   @id @db.VarChar(36)
  repo           String   @default("") @db.VarChar(300)
  branch         String   @default("main") @db.VarChar(200)
  auto           Boolean  @default(true)
  requireCi      Boolean  @default(true) @map("require_ci")
  // With automatic updates off: the commit an administrator released.
  approvedCommit String   @default("") @map("approved_commit") @db.VarChar(40)
  updatedBy      String?  @map("updated_by") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("update_settings")
}

// A one-line node install (provision.ts). Node-local like every cluster_*
// table. The token itself is never stored; its secret is kept only in
// wrapped form until the install is finished, revoked or expired.
model ClusterInstall {
  id            String    @id @db.VarChar(36)
  secretEnc     String?   @map("secret_enc") @db.VarChar(255)
  // OPEN → PROVISIONED (configuration handed over) → DONE (node paired);
  // or EXPIRED, LOCKED (too many wrong proofs), REVOKED.
  status        String    @default("OPEN") @db.VarChar(20)
  // The HOST pairing window the new node joins through.
  peerId        String    @map("peer_id") @db.VarChar(36)
  domain        String    @db.VarChar(253)
  name          String    @default("") @db.VarChar(120)
  withAi        Boolean   @default(false) @map("with_ai")
  acmeEmail     String    @default("") @map("acme_email") @db.VarChar(254)
  // How the new server is reached: web mode, ports, addresses, allowed
  // sources (JSON, src/cluster/installOptions.ts).
  options       String?   @db.Text
  failures      Int       @default(0)
  expiresAt     DateTime  @map("expires_at")
  provisionedAt DateTime? @map("provisioned_at")
  createdBy     String?   @map("created_by") @db.VarChar(100)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, expiresAt])
  @@map("cluster_installs")
}

// Version and tombstone registry, and at the same time the change feed: one
// row per replicated data row. `version` is a microsecond timestamp that only
// ever grows for a given row; together with `origin` it decides
// last-writer-wins. `seq` is the row's place in the feed — each change moves
// it to the end — and `via` names the peer a received change came from, so it
// is not offered straight back.
model ClusterRowState {
  tableName String   @map("table_name") @db.VarChar(64)
  pkHash    String   @map("pk_hash") @db.Char(64)
  pk        String   @db.VarChar(1024)
  version   BigInt   @db.UnsignedBigInt
  origin    String   @db.VarChar(36)
  via       String?  @db.VarChar(36)
  deleted   Boolean  @default(false)
  changedAt DateTime @default(now()) @map("changed_at")
  seq       BigInt   @default(0) @db.UnsignedBigInt

  @@id([tableName, pkHash])
  @@index([deleted, changedAt])
  @@index([seq])
  @@map("cluster_row_state")
}

// Received changes that cannot be applied yet (parent row not here yet, or a
// unique value still held by a row whose own update is in flight).
model ClusterDeferred {
  tableName   String   @map("table_name") @db.VarChar(64)
  pkHash      String   @map("pk_hash") @db.Char(64)
  fromPeer    String   @map("from_peer") @db.VarChar(36)
  version     BigInt   @db.UnsignedBigInt
  origin      String   @db.VarChar(36)
  payload     String   @db.LongText
  reason      String   @default("") @db.VarChar(40)
  detail      String   @default("") @db.VarChar(500)
  attempts    Int      @default(0)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastTriedAt DateTime @default(now()) @map("last_tried_at")

  @@id([tableName, pkHash])
  @@index([lastTriedAt])
  @@map("cluster_deferred")
}
