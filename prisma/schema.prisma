// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(uuid())
  stableUid          String   @unique @map("stable_uid")
  username           String   @unique
  webuntisKlasseId   Int      @default(0) @map("webuntis_klasse_id")
  webuntisKlasseName String   @default("") @map("webuntis_klasse_name")
  passwordHash       String?  @map("password_hash") @db.VarChar(100)
  isUntisUser        Boolean  @default(true) @map("is_untis_user")
  // Account role: "student" (default) or "parent". Parents have their own todos,
  // see only the class name (never appear in member lists) and have no reminders.
  role               String   @default("student") @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  todos                  Todo[]
  classMembers           ClassMember[]
  refreshTokens          RefreshToken[]
  pushSubscriptions      PushSubscription[]
  // Pokyh Learn is deliberately attached to the existing POKYH identity.  A
  // profile is created lazily on first Learn use, which also marks this account
  // as persistent across the school-year cleanup.
  learnProfile           LearnProfile?
  learnCoursesCreated    LearnCourse[]           @relation("LearnCourseCreator")
  learnCourseAccesses    LearnCourseAccess[]
  learnEnrollments       LearnEnrollment[]
  learnVocabularyEntries LearnVocabularyEntry[]  @relation("LearnVocabularyCreator")
  learnVocabularyReviews LearnVocabularyReview[]
  learnQuizAttempts      LearnQuizAttempt[]
  // Privacy-preserving, per-day learning aggregates. These retain counts and
  // dates, not answer text, and power the learner's own analytics screen.
  learnActivityDays      LearnActivityDaily[]
  learnTeamsCreated      LearnTeam[]             @relation("LearnTeamCreator")
  learnTeamMemberships   LearnTeamMember[]
  learnSectionCompletions LearnSectionCompletion[]
  learnAiAccessGrant     LearnAiAccessGrant?
  learnAiUsageCounters   LearnAiUsageCounter[]
  learnAiTrainingPrompts LearnAiTrainingPrompt[]

  @@map("users")
}

model PushSubscription {
  id          String   @id @default(uuid())
  stableUid   String   @map("stable_uid")
  endpoint    String   @unique @db.VarChar(500)
  p256dh      String   @db.VarChar(255)
  auth        String   @db.VarChar(255)
  jsessionid  String   @db.VarChar(100)
  bearerToken String   @map("bearer_token") @db.VarChar(1000)
  knownUnread Int      @default(-1) @map("known_unread")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@map("push_subscriptions")
}

model Admin {
  stableUid      String   @id @map("stable_uid")
  canCreateClass Boolean  @default(true) @map("can_create_class")
  passwordHash   String?  @map("password_hash") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Class {
  id               String   @id
  name             String
  code             String   @unique @db.Char(6)
  webuntisKlasseId Int      @map("webuntis_klasse_id")
  createdBy        String   @map("created_by")
  createdByName    String   @map("created_by_name")
  createdAt        DateTime @default(now()) @map("created_at")

  members   ClassMember[]
  reminders Reminder[]

  @@map("classes")
}

model ClassMember {
  classId   String   @map("class_id")
  stableUid String   @map("stable_uid")
  username  String
  // "student" members are visible in the class; "parent" members are hidden
  // (they can see the class name but never appear in the member list).
  role      String   @default("student") @db.VarChar(20)
  joinedAt  DateTime @default(now()) @map("joined_at")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@id([classId, stableUid])
  @@index([stableUid])
  @@map("class_members")
}

model Todo {
  id         String    @id @default(uuid())
  stableUid  String    @map("stable_uid")
  title      String    @db.VarChar(500)
  details    String    @default("") @db.VarChar(5000)
  dueAt      DateTime? @map("due_at")
  done       Boolean   @default(false)
  doneAt     DateTime? @map("done_at")
  notifiedAt DateTime? @map("notified_at")
  // Set once a todo has been expired (overdue) for >24h. Archived todos are
  // hidden from users and live on the server only — viewable by admins.
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@index([stableUid, archivedAt])
  @@index([archivedAt])
  // Speeds the per-minute "due todos" notification scan.
  @@index([notifiedAt, dueAt])
  @@map("todos")
}

model Reminder {
  id                String    @id @default(uuid())
  classId           String    @map("class_id")
  title             String    @db.VarChar(500)
  body              String    @default("") @db.VarChar(5000)
  remindAt          DateTime  @map("remind_at")
  createdBy         String    @map("created_by")
  createdByName     String    @map("created_by_name")
  createdByUsername String    @map("created_by_username")
  notifiedAt        DateTime? @map("notified_at")
  // Set once a reminder has been expired for >24h. Archived reminders are hidden
  // from class members and live on the server only — viewable by admins.
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([classId, archivedAt])
  @@index([archivedAt])
  // Speeds the per-minute "due reminders" notification scan.
  @@index([notifiedAt, remindAt])
  @@map("reminders")
}

model Comment {
  id         String   @id @default(uuid())
  reminderId String   @map("reminder_id")
  classId    String   @map("class_id")
  stableUid  String   @map("stable_uid")
  username   String
  body       String   @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId])
  @@map("comments")
}

model DishComment {
  id        String   @id @default(uuid())
  dishId    String   @map("dish_id")
  stableUid String   @map("stable_uid")
  username  String
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dishId])
  @@map("dish_comments")
}

model Dish {
  id           String   @id @default(uuid())
  nameDe       String   @map("name_de") @db.VarChar(500)
  nameIt       String   @default("") @map("name_it") @db.VarChar(500)
  nameEn       String   @default("") @map("name_en") @db.VarChar(500)
  descDe       String   @default("") @map("desc_de") @db.VarChar(2000)
  descIt       String   @default("") @map("desc_it") @db.VarChar(2000)
  descEn       String   @default("") @map("desc_en") @db.VarChar(2000)
  imageUrl     String   @default("") @map("image_url") @db.VarChar(1000)
  category     String   @default("") @db.VarChar(200)
  tags         String   @default("[]") @db.VarChar(2000)
  prepTime     Int      @default(0) @map("prep_time")
  calories     Int      @default(0)
  price        Float    @default(0)
  protein      Float    @default(0)
  fat          Float    @default(0)
  allergens    String   @default("[]") @db.VarChar(2000)
  isVegetarian Boolean  @default(false) @map("is_vegetarian")
  isVegan      Boolean  @default(false) @map("is_vegan")
  date         DateTime @db.Date
  sortOrder    Int      @default(0) @map("sort_order")
  plan         String   @default("summer") @db.VarChar(10)
  sourceId     String?  @map("source_id") @db.VarChar(200)
  // Stable slug derived from nameDe. Ratings and comments reference this key,
  // so re-imports (which regenerate the internal id) or same-name dishes in
  // both plans share bewertungen/kommentare automatically.
  stableKey    String   @default("") @map("stable_key") @db.VarChar(200)
  // Cycle-position of the dish's week (1..N). Set at import (parsed from
  // sourceId like "w6_mo" or inferred from date order) and NEVER changed by
  // anchor/rotate. The UI labels weeks by this ordinal, so Woche 1's content
  // keeps being Woche 1 even after rotation puts it later in the calendar.
  weekOrdinal  Int      @default(0) @map("week_ordinal")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([plan, date])
  @@index([plan, sourceId])
  @@index([stableKey])
  @@map("dishes")
}

model DishImage {
  dishId    String   @id @map("dish_id")
  data      Bytes    @db.LongBlob
  mimeType  String   @map("mime_type") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dish_images")
}

model DishRating {
  dishId    String   @map("dish_id")
  stableUid String   @map("stable_uid")
  // Account name at rating time. A stableUid changes when the user row is
  // recreated (school-year rollover, database rebuild); the username lets the
  // vote be reclaimed so nobody can rate the same dish twice.
  username  String?  @db.VarChar(100)
  stars     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([dishId, stableUid])
  @@index([username])
  @@map("dish_ratings")
}

model RefreshToken {
  id        String    @id @default(uuid())
  stableUid String    @map("stable_uid")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@map("refresh_tokens")
}

model KnownSubject {
  key       String   @id @db.VarChar(200)
  longName  String   @map("long_name") @db.VarChar(200)
  shortName String   @map("short_name") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("known_subjects")
}

model SubjectImage {
  subject   String   @id @db.VarChar(200)
  data      Bytes    @db.LongBlob
  mimeType  String   @map("mime_type") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subject_images")
}

model ApiKey {
  id         String    @id @default(uuid())
  keyHash    String    @unique @map("key_hash")
  name       String
  // Free-text purpose/description set by the issuing admin (e.g. "mobile CI",
  // "partner integration"). Informational only, never parsed or enforced.
  purpose    String    @default("") @db.VarChar(255)
  // Free-text platform/OS hint supplied at creation (e.g. "iOS", "n8n").
  // Informational only.
  platform   String    @default("") @db.VarChar(80)
  // Comma-separated least-privilege capabilities. Existing rows retain full
  // compatibility through the `*` default; new keys should be scoped.
  scopes     String    @default("*") @db.VarChar(255)
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@map("api_keys")
}

model RequestLog {
  id        String   @id @default(uuid())
  method    String   @db.VarChar(10)
  path      String   @db.VarChar(500)
  status    Int
  duration  Int
  ip        String?  @db.VarChar(45)
  stableUid String?  @map("stable_uid") @db.VarChar(64)
  username  String?  @db.VarChar(100)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  error     String?  @db.VarChar(1000)
  // Correlates this row with the same request's Winston log lines and its
  // X-Request-Id response header (see src/middleware/requestId.ts).
  requestId String?  @map("request_id") @db.VarChar(64)
  // 'learn' | 'core' — which feature area this request belongs to, derived
  // from the path prefix in requestLogger.ts. Lets the admin Logs page filter
  // by feature without a second logging system.
  scope     String?  @db.VarChar(20)
  // Identifier for an administrator-issued integration key. The plaintext key
  // and its hash are never written to request logs.
  apiKeyId  String?  @map("api_key_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([stableUid])
  @@index([username])
  @@index([createdAt])
  @@index([requestId])
  @@index([apiKeyId])
  @@map("request_logs")
}

// Admin-editable scheduled-backup settings — a singleton row (id is always 1),
// same pattern as LearnConfig. A missing row, or a null field on it, falls
// back to the BACKUP_* environment defaults in src/config.ts. Individual
// backup files themselves are not tracked here — they're listed by scanning
// config.backupDir directly (see src/services/dbBackup.ts), so this table
// never needs to be kept in sync with the filesystem.
model BackupConfig {
  id            Int       @id @default(1)
  enabled       Boolean?
  // UTC hour (0-23) the daily backup targets.
  scheduleHour  Int?      @map("schedule_hour")
  retentionDays Int?      @map("retention_days")
  lastRunAt     DateTime? @map("last_run_at")
  // 'ok' or 'error' — the outcome of the most recent scheduled or manual run.
  lastRunStatus String?   @map("last_run_status") @db.VarChar(20)
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedBy     String?   @map("updated_by")

  @@map("backup_config")
}

// ─── School year archive ──────────────────────────────────────────────────────
// On August 1st each year school-only users, classes, todos and reminders are
// snapshotted here and then removed from the live tables so the new school year
// starts fresh. Admins and users with a LearnProfile keep their User records.

model SchoolYear {
  id        String   @id @default(uuid())
  label     String   @unique // "2025/2026"
  startYear Int      @unique @map("start_year") // 2025
  rolledAt  DateTime @map("rolled_at") // when rollover was performed
  note      String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  archivedUsers     ArchivedUser[]
  archivedClasses   ArchivedClass[]
  archivedTodos     ArchivedTodo[]
  archivedReminders ArchivedReminder[]

  @@map("school_years")
}

model ArchivedUser {
  id                 String   @id @default(uuid())
  schoolYearId       String   @map("school_year_id")
  stableUid          String   @map("stable_uid")
  username           String
  role               String   @default("student") @db.VarChar(20)
  webuntisKlasseId   Int      @default(0) @map("webuntis_klasse_id")
  webuntisKlasseName String   @default("") @map("webuntis_klasse_name") @db.VarChar(255)
  classId            String?  @map("class_id")
  classCode          String?  @map("class_code")
  className          String?  @map("class_name")
  createdAt          DateTime @map("created_at")

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@index([schoolYearId])
  @@index([schoolYearId, stableUid])
  @@map("archived_users")
}

model ArchivedClass {
  id               String   @id @default(uuid())
  schoolYearId     String   @map("school_year_id")
  originalId       String   @map("original_id")
  name             String
  code             String   @db.Char(6)
  webuntisKlasseId Int      @default(0) @map("webuntis_klasse_id")
  createdBy        String   @map("created_by")
  createdByName    String   @default("") @map("created_by_name")
  memberCount      Int      @default(0) @map("member_count")
  // MySQL does not support a portable literal default for TEXT. Every archive
  // write supplies an explicit JSON array, so the schema remains compatible
  // with `prisma db push` and avoids a silent database-specific fallback.
  membersJson      String   @map("members_json") @db.Text
  createdAt        DateTime @map("created_at")

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@index([schoolYearId])
  @@map("archived_classes")
}

model ArchivedTodo {
  id           String    @id @default(uuid())
  schoolYearId String    @map("school_year_id")
  originalId   String    @map("original_id")
  stableUid    String    @map("stable_uid")
  username     String    @default("")
  title        String    @db.VarChar(500)
  details      String    @default("") @db.VarChar(5000)
  dueAt        DateTime? @map("due_at")
  done         Boolean   @default(false)
  doneAt       DateTime? @map("done_at")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @map("created_at")

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@index([schoolYearId])
  @@index([schoolYearId, stableUid])
  @@map("archived_todos")
}

model ArchivedReminder {
  id                String    @id @default(uuid())
  schoolYearId      String    @map("school_year_id")
  originalId        String    @map("original_id")
  classId           String    @map("class_id")
  className         String    @default("") @map("class_name")
  title             String    @db.VarChar(500)
  body              String    @default("") @db.VarChar(5000)
  remindAt          DateTime  @map("remind_at")
  createdBy         String    @map("created_by")
  createdByName     String    @default("") @map("created_by_name")
  createdByUsername String    @default("") @map("created_by_username")
  archivedAt        DateTime? @map("archived_at")
  commentsJson      String    @map("comments_json") @db.Text
  createdAt         DateTime  @map("created_at")

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@index([schoolYearId])
  @@map("archived_reminders")
}

model FrontendActivityLog {
  id        String   @id @default(uuid())
  event     String   @db.VarChar(50)
  page      String?  @db.VarChar(500)
  detail    String?  @db.VarChar(500)
  stableUid String?  @map("stable_uid") @db.VarChar(64)
  username  String?  @db.VarChar(100)
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([stableUid])
  @@index([username])
  @@index([createdAt])
  @@index([event])
  @@map("frontend_activity_logs")
}

// ─── Pokyh Learn ─────────────────────────────────────────────────────────────
// Learn content lives alongside the existing POKYH account rather than creating
// a second identity or token system.  Fields ending in `Json` intentionally use
// text so import/export payloads remain portable and the public API can validate
// their shape before persisting them.

model LearnProfile {
  stableUid        String    @id @map("stable_uid")
  dailyGoalMinutes Int       @default(15) @map("daily_goal_minutes")
  timezone         String    @default("") @db.VarChar(80)
  locale           String    @default("de") @db.VarChar(5)
  theme            String    @default("system") @db.VarChar(10)
  privacyNoticeVersion String @default("") @map("privacy_notice_version") @db.VarChar(80)
  privacyNoticeAcknowledgedAt DateTime? @map("privacy_notice_acknowledged_at")
  dailyStreak      Int       @default(0) @map("daily_streak")
  lastActiveAt     DateTime? @map("last_active_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@index([lastActiveAt])
  @@map("learn_profiles")
}

model LearnCourse {
  id            String   @id @default(uuid())
  slug          String   @unique @db.VarChar(191)
  title         String   @db.VarChar(160)
  summary       String   @default("") @db.VarChar(2000)
  subject       String   @default("") @db.VarChar(120)
  language      String   @default("") @db.VarChar(80)
  level         String   @default("") @db.VarChar(50)
  // PRIVATE, TEAM, or PUBLIC.  PUBLIC courses are only shown in the catalog
  // once their status is PUBLISHED.
  visibility    String   @default("PRIVATE") @db.VarChar(20)
  // DRAFT, PUBLISHED, or ARCHIVED.
  status        String   @default("DRAFT") @db.VarChar(20)
  coverImageUrl String   @default("") @map("cover_image_url") @db.VarChar(1000)
  createdBy     String   @map("created_by")
  teamId        String?  @map("team_id")
  // When true, a platform administrator has deliberately locked this course's
  // ownership — reassigning createdBy is blocked until an admin unlocks it
  // first. A safety guard against accidental reassignment, not a permission
  // change: an admin can always toggle it, just not reassign in the same step.
  ownerLocked   Boolean  @default(false) @map("owner_locked")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  creator      User                   @relation("LearnCourseCreator", fields: [createdBy], references: [stableUid], onDelete: Cascade)
  team         LearnTeam?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sections     LearnCourseSection[]
  accessGrants LearnCourseAccess[]
  enrollments  LearnEnrollment[]
  vocabulary   LearnVocabularyEntry[]
  quizAttempts LearnQuizAttempt[]
  sectionCompletions LearnSectionCompletion[]
  activityDays LearnActivityDaily[]

  @@index([createdBy])
  @@index([teamId])
  @@index([visibility, status, updatedAt])
  @@map("learn_courses")
}

model LearnCourseSection {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String   @db.VarChar(200)
  summary     String   @default("") @db.VarChar(2000)
  // LESSON, VOCABULARY, GRAMMAR, QUIZ, or a future server-defined type.
  type        String   @default("LESSON") @db.VarChar(40)
  sortOrder   Int      @default(0) @map("sort_order")
  contentJson String   @map("content_json") @db.LongText
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course     LearnCourse            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  vocabulary LearnVocabularyEntry[]
  completions LearnSectionCompletion[]

  @@unique([courseId, sortOrder])
  @@index([courseId])
  @@map("learn_course_sections")
}

// Explicit per-course grants make it possible for a POKYH administrator to
// allow trusted learners to contribute content without making them global admins.
model LearnCourseAccess {
  courseId   String   @map("course_id")
  stableUid  String   @map("stable_uid")
  // VIEW, EDIT, or MANAGE.
  permission String   @default("VIEW") @db.VarChar(20)
  grantedBy  String?  @map("granted_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  course LearnCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@id([courseId, stableUid])
  @@index([stableUid])
  @@map("learn_course_access")
}

model LearnEnrollment {
  courseId          String    @map("course_id")
  stableUid         String    @map("stable_uid")
  // ACTIVE, PAUSED, or COMPLETED.
  status            String    @default("ACTIVE") @db.VarChar(20)
  progressPercent   Float     @default(0) @map("progress_percent")
  completedSections Int       @default(0) @map("completed_sections")
  lastOpenedAt      DateTime? @map("last_opened_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  course LearnCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@id([courseId, stableUid])
  @@index([stableUid, lastOpenedAt])
  @@map("learn_enrollments")
}

// A completion is an explicit learner action on one real server-side section.
// Aggregate enrollment progress is derived from these records instead of
// accepting an arbitrary percentage from the browser.
model LearnSectionCompletion {
  stableUid   String   @map("stable_uid")
  courseId    String   @map("course_id")
  sectionId   String   @map("section_id")
  completedAt DateTime @default(now()) @map("completed_at")

  user    User               @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)
  course  LearnCourse        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section LearnCourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([stableUid, sectionId])
  @@index([courseId, stableUid])
  @@map("learn_section_completions")
}

model LearnVocabularyEntry {
  id                 String   @id @default(uuid())
  courseId           String   @map("course_id")
  sectionId          String?  @map("section_id")
  sourceLanguage     String   @map("source_language") @db.VarChar(20)
  targetLanguage     String   @map("target_language") @db.VarChar(20)
  sourceText         String   @map("source_text") @db.VarChar(500)
  targetText         String   @map("target_text") @db.VarChar(500)
  normalizedSource   String   @map("normalized_source") @db.VarChar(500)
  normalizedTarget   String   @map("normalized_target") @db.VarChar(500)
  article            String   @default("") @db.VarChar(40)
  partOfSpeech       String   @default("") @map("part_of_speech") @db.VarChar(80)
  notes              String   @default("") @db.VarChar(2000)
  tagsJson           String   @map("tags_json") @db.Text
  // UNVERIFIED, VERIFIED, or FLAGGED.  A future dictionary integration can
  // populate verificationSource without changing the entry contract.
  verificationStatus String   @default("UNVERIFIED") @map("verification_status") @db.VarChar(20)
  verificationSource String   @default("") @map("verification_source") @db.VarChar(120)
  createdBy          String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  course       LearnCourse             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section      LearnCourseSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  creator      User                    @relation("LearnVocabularyCreator", fields: [createdBy], references: [stableUid], onDelete: Cascade)
  reviewStates LearnVocabularyReview[]
  aiTrainingPrompts LearnAiTrainingPrompt[]

  @@index([courseId, sectionId])
  @@index([createdBy])
  @@map("learn_vocabulary_entries")
}

// Per-user spaced-review state.  It is updated atomically with a quiz attempt,
// so a wrong answer remains recoverable for a dedicated review quiz.
model LearnVocabularyReview {
  id             String    @id @default(uuid())
  stableUid      String    @map("stable_uid")
  entryId        String    @map("entry_id")
  intervalDays   Int       @default(0) @map("interval_days")
  easeFactor     Float     @default(2.5) @map("ease_factor")
  dueAt          DateTime  @default(now()) @map("due_at")
  lastReviewedAt DateTime? @map("last_reviewed_at")
  correctCount   Int       @default(0) @map("correct_count")
  incorrectCount Int       @default(0) @map("incorrect_count")
  lastWasCorrect Boolean   @default(false) @map("last_was_correct")
  // The next prompt reverses this direction. The server stores it rather
  // than letting a browser choose which translation should be graded.
  lastDirection  String?   @map("last_direction") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user  User                 @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)
  entry LearnVocabularyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([stableUid, entryId])
  @@index([stableUid, dueAt])
  @@map("learn_vocabulary_reviews")
}

// A durable, idempotent record of server-graded answers.  `answersJson` stores
// the submitted answer and the server result; expected answers never come from
// the client and are not exposed by the review queue endpoint.
model LearnQuizAttempt {
  id             String   @id @default(uuid())
  stableUid      String   @map("stable_uid")
  courseId       String   @map("course_id")
  mode           String   @default("PRACTICE") @db.VarChar(40)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(191)
  answersJson    String   @map("answers_json") @db.LongText
  totalQuestions Int      @map("total_questions")
  correctAnswers Int      @map("correct_answers")
  score          Float    @default(0)
  // Client-measured wall-clock time actively spent on this attempt (session
  // start to submit), sanity-capped server-side. Optional and defaults to 0
  // for older clients — never inferred or estimated, only ever real elapsed
  // time the client actually observed, so profile/streak minutes stay honest.
  durationMs     Int      @default(0) @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  user   User        @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)
  course LearnCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([stableUid, idempotencyKey])
  @@index([stableUid, createdAt])
  @@index([courseId, createdAt])
  @@map("learn_quiz_attempts")
}

// One compact activity row per learner, course and local calendar day. It is
// updated in the same transaction as a server-graded quiz attempt, so the
// analytics view is durable, idempotent and never needs raw answer text.
model LearnActivityDaily {
  stableUid      String   @map("stable_uid")
  courseId       String   @map("course_id")
  dayKey         String   @map("day_key") @db.VarChar(10)
  attemptCount   Int      @default(0) @map("attempt_count")
  answerCount    Int      @default(0) @map("answer_count")
  correctCount   Int      @default(0) @map("correct_count")
  durationMs     Int      @default(0) @map("duration_ms")
  lastActivityAt DateTime @map("last_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user   User        @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)
  course LearnCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([stableUid, courseId, dayKey])
  @@index([stableUid, dayKey])
  @@index([courseId, dayKey])
  @@map("learn_activity_daily")
}

model LearnTeam {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(120)
  description String   @default("") @db.VarChar(1000)
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator User              @relation("LearnTeamCreator", fields: [createdBy], references: [stableUid], onDelete: Cascade)
  members LearnTeamMember[]
  courses LearnCourse[]
  aiAccessGrant LearnAiTeamAccessGrant?

  @@index([createdBy])
  @@map("learn_teams")
}

model LearnTeamMember {
  teamId    String   @map("team_id")
  stableUid String   @map("stable_uid")
  // OWNER, MANAGER, or MEMBER.
  role      String   @default("MEMBER") @db.VarChar(20)
  joinedAt  DateTime @default(now()) @map("joined_at")

  team LearnTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@id([teamId, stableUid])
  @@index([stableUid])
  @@map("learn_team_members")
}

// Admin-editable Learn configuration — a singleton row (id is always 1). Read
// live via src/services/learnConfig.ts with a short in-memory cache; a missing
// row, or a null field on it, falls back to the LEARN_* environment defaults
// in src/config.ts, so the app works correctly before any admin ever saves
// this. LEARN_ALLOWED_ORIGINS is deliberately NOT included: it is a security-
// boundary value and stays environment-only, never admin-editable at runtime.
model LearnConfig {
  id                           Int      @id @default(1)
  legalGateEnabled             Boolean? @map("legal_gate_enabled")
  // Set via the admin UI but never read back in plaintext by the API —
  // matches docs/legal-readiness.md's requirement to report the legal gate
  // as ready without exposing the approval reference itself.
  webUntisAuthorizationReference String? @map("webuntis_authorization_reference") @db.VarChar(255)
  privacyNoticeUrl             String?  @map("privacy_notice_url") @db.VarChar(500)
  privacyNoticeVersion         String?  @map("privacy_notice_version") @db.VarChar(80)
  dictionaryEnabled            Boolean? @map("dictionary_enabled")
  dictionaryProvider           String?  @map("dictionary_provider") @db.VarChar(40)
  dictionaryBaseUrl            String?  @map("dictionary_base_url") @db.VarChar(500)
  dictionaryContactEmail       String?  @map("dictionary_contact_email") @db.VarChar(255)
  dictionaryAllowedPairs       String?  @map("dictionary_allowed_pairs") @db.VarChar(500)
  dictionaryTimeoutMs          Int?     @map("dictionary_timeout_ms")
  dictionaryCacheTtlMs         Int?     @map("dictionary_cache_ttl_ms")
  dictionaryMaxCacheEntries    Int?     @map("dictionary_max_cache_entries")
  // Free Dictionary API is configured separately from optional translation
  // suggestions. The backend supports its documented English endpoint only.
  dictionaryValidationEnabled  Boolean? @map("dictionary_validation_enabled")
  dictionaryValidationProvider String?  @map("dictionary_validation_provider") @db.VarChar(40)
  dictionaryValidationBaseUrl  String?  @map("dictionary_validation_base_url") @db.VarChar(500)
  dictionaryValidationTimeoutMs Int?    @map("dictionary_validation_timeout_ms")
  dictionaryValidationCacheTtlMs Int?   @map("dictionary_validation_cache_ttl_ms")
  dictionaryValidationMaxCacheEntries Int? @map("dictionary_validation_max_cache_entries")
  // Adaptive-review policy and pseudonymous analytics retention. The browser
  // never supplies scheduling decisions; these values are applied server-side.
  reviewInitialIntervalDays Int?        @map("review_initial_interval_days")
  reviewMaxIntervalDays     Int?        @map("review_max_interval_days")
  reviewMinimumEase         Float?      @map("review_minimum_ease")
  reviewMaximumEase         Float?      @map("review_maximum_ease")
  reviewCorrectEaseStep     Float?      @map("review_correct_ease_step")
  reviewIncorrectEasePenalty Float?     @map("review_incorrect_ease_penalty")
  reviewWrongDelayMinutes   Int?        @map("review_wrong_delay_minutes")
  analyticsRetentionDays    Int?        @map("analytics_retention_days")
  importMaxCourses             Int?     @map("import_max_courses")
  importMaxSectionsPerCourse   Int?     @map("import_max_sections_per_course")
  importMaxVocabularyPerCourse Int?     @map("import_max_vocabulary_per_course")
  updatedAt                    DateTime @updatedAt @map("updated_at")
  updatedBy                    String?  @map("updated_by")

  @@map("learn_config")
}

// ─── Pokyh Learn AI trainer ─────────────────────────────────────────────────
// AI exists only inside vocabulary practice. A prompt stores the AI-generated
// sentence and its expected translation server-side for a short time; clients
// receive only the source sentence, so they cannot supply their own answer key
// or make a grading decision.
model LearnAiTrainingPrompt {
  id           String   @id @default(uuid())
  stableUid    String   @map("stable_uid")
  entryId      String   @map("entry_id")
  direction    String   @db.VarChar(20)
  promptText   String   @map("prompt_text") @db.VarChar(1000)
  expectedText String   @map("expected_text") @db.VarChar(1000)
  modelName    String   @map("model_name") @db.VarChar(120)
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")
  completedAt  DateTime? @map("completed_at")
  resultCorrect Boolean? @map("result_correct")

  user  User                 @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)
  entry LearnVocabularyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([stableUid, expiresAt])
  @@index([entryId])
  @@map("learn_ai_training_prompts")
}

// Pilot allowlist — the only source of AI-trainer access. A learner with no
// row here, or whose grant has revokedAt set, gets 403 on every /learn/ai/*
// route regardless of any other configuration.
model LearnAiAccessGrant {
  stableUid String    @id @map("stable_uid")
  grantedBy String    @map("granted_by")
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedBy String?   @map("revoked_by")
  revokedAt DateTime? @map("revoked_at")
  note      String    @default("") @db.VarChar(500)

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@index([revokedAt])
  @@map("learn_ai_access_grants")
}

// A whole-team grant: every current and future member of the team has
// trainer access without an individual LearnAiAccessGrant row per person —
// canonical Pokyh administrator action only, same spirit as team creation
// itself. hasActiveAiGrant() (learnAiAccess.ts) checks both this and the
// per-user grant above; either is sufficient.
model LearnAiTeamAccessGrant {
  teamId    String    @id @map("team_id")
  grantedBy String    @map("granted_by")
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedBy String?   @map("revoked_by")
  revokedAt DateTime? @map("revoked_at")
  note      String    @default("") @db.VarChar(500)

  team LearnTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([revokedAt])
  @@map("learn_ai_team_access_grants")
}

// The authoritative per-user quota ledger (src/services/learnAiRateLimit.ts).
// Redis may accelerate the check but this table enforces it, so the limit
// still holds correctly if Redis is absent or fails.
model LearnAiUsageCounter {
  stableUid    String   @map("stable_uid")
  windowStart  DateTime @map("window_start")
  messageCount Int      @default(0) @map("message_count")
  tokenCount   Int      @default(0) @map("token_count")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [stableUid], references: [stableUid], onDelete: Cascade)

  @@id([stableUid, windowStart])
  @@index([windowStart])
  @@map("learn_ai_usage_counters")
}

// Admin-editable AI operational policy. A missing row, or a null field on it,
// falls back to the LEARN_AI_* environment defaults in src/config.ts.
model LearnAiConfig {
  id                         Int      @id @default(1)
  // Global kill-switch, independent of per-user pilot grants — both must
  // allow a request through.
  enabled                    Boolean? @map("enabled")
  modelName                  String?  @map("model_name") @db.VarChar(120)
  // num_ctx sent to Ollama. Deliberately kept small by default: RAM for a
  // CPU-quantized model grows sharply with context length (see docs).
  contextTokens              Int?     @map("context_tokens")
  numPredictFast             Int?     @map("num_predict_fast")
  rateLimitMessagesPerHour   Int?     @map("rate_limit_messages_per_hour")
  // The in-app trainer caps outgoing model work before Ollama. This default
  // is intentionally configurable so a larger verified host can serve a
  // whole class without exposing an unbounded inference endpoint.
  maxConcurrentTrainingGenerations Int? @map("max_concurrent_training_generations")
  ollamaBaseUrl              String?  @map("ollama_base_url") @db.VarChar(300)
  ollamaTimeoutMs            Int?     @map("ollama_timeout_ms")
  updatedAt                  DateTime @updatedAt @map("updated_at")
  updatedBy                  String?  @map("updated_by")

  @@map("learn_ai_config")
}

// ─── Announcement popups ──────────────────────────────────────────────────────
// Admin-authored popups shown inside the web app and/or the Android app.
// `content` is the Markdown/HTML source the admin typed; `contentHtml` is the
// sanitised render delivered to clients (see src/services/popupRender.ts), so
// clients never parse or trust raw admin input themselves.
//
// Scheduling: a popup is live while `enabled` and now ∈ [startsAt, endsAt)
// (either bound may be null = open). The window is split into `showCount`
// equal slots and a client shows the popup at most once per slot — e.g.
// 7 shows over 7 days = at most once a day, and nothing after the window ends
// regardless of how many slots were missed. "once" is simply showCount = 1.
// "Seen" state is tracked per device by the clients, keyed by id + revision;
// bumping `revision` makes every client treat the popup as unseen again.
model Popup {
  id          String    @id @default(uuid())
  title       String    @db.VarChar(200)
  content     String    @db.MediumText
  contentHtml String    @map("content_html") @db.MediumText
  // "all" | "web" | "android"
  platform    String    @default("all") @db.VarChar(10)
  // "all" | "users" | "guests" — guests only exist on the website; the
  // Android app is always signed in and requests the "users" audience.
  audience    String    @default("all") @db.VarChar(10)
  // "once" | "recurring"
  mode        String    @default("once") @db.VarChar(12)
  showCount   Int       @default(1) @map("show_count")
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  enabled     Boolean   @default(true)
  revision    Int       @default(1)
  createdBy   String?   @map("created_by") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([enabled, platform])
  @@map("popups")
}
